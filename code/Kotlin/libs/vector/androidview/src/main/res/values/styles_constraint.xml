<resources>

    <style name="ConstraintLayout">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <style name="ConstraintLayout.Match" />

    <style name="ConstraintLayout.Match.Horizontal">
        <item name="android:layout_width">0dp</item>
        <item name="layout_constraintStart_toStartOf">parent</item>
        <item name="layout_constraintEnd_toEndOf">parent</item>
    </style>

    <style name="ConstraintLayout.Match.Vertical">
        <item name="android:layout_height">0dp</item>
        <item name="layout_constraintTop_toTopOf">parent</item>
        <item name="layout_constraintBottom_toBottomOf">parent</item>
    </style>

    <style name="ConstraintLayout.Match.All">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="layout_constraintTop_toTopOf">parent</item>
        <item name="layout_constraintBottom_toBottomOf">parent</item>
        <item name="layout_constraintStart_toStartOf">parent</item>
        <item name="layout_constraintEnd_toEndOf">parent</item>
    </style>

    <style name="ConstraintLayout.Align" />

    <style name="ConstraintLayout.Align.Left">
        <item name="layout_constraintStart_toStartOf">parent</item>
    </style>

    <style name="ConstraintLayout.Align.Right">
        <item name="layout_constraintEnd_toEndOf">parent</item>
    </style>

    <style name="ConstraintLayout.Align.Top">
        <item name="layout_constraintTop_toTopOf">parent</item>
    </style>

    <style name="ConstraintLayout.Align.TopCenter">
        <item name="layout_constraintTop_toTopOf">parent</item>
        <item name="layout_constraintStart_toStartOf">parent</item>
        <item name="layout_constraintEnd_toEndOf">parent</item>
    </style>

    <style name="ConstraintLayout.Align.TopLeft">
        <item name="layout_constraintTop_toTopOf">parent</item>
        <item name="layout_constraintStart_toStartOf">parent</item>
    </style>

    <style name="ConstraintLayout.Align.TopRight">
        <item name="layout_constraintTop_toTopOf">parent</item>
        <item name="layout_constraintEnd_toEndOf">parent</item>
    </style>

    <style name="ConstraintLayout.Align.Bottom">
        <item name="layout_constraintBottom_toBottomOf">parent</item>
    </style>

    <style name="ConstraintLayout.Align.BottomCenter">
        <item name="layout_constraintBottom_toBottomOf">parent</item>
        <item name="layout_constraintStart_toStartOf">parent</item>
        <item name="layout_constraintEnd_toEndOf">parent</item>
    </style>

    <style name="ConstraintLayout.Align.BottomLeft">
        <item name="layout_constraintBottom_toBottomOf">parent</item>
        <item name="layout_constraintStart_toStartOf">parent</item>
    </style>

    <style name="ConstraintLayout.Align.BottomRight">
        <item name="layout_constraintBottom_toBottomOf">parent</item>
        <item name="layout_constraintEnd_toEndOf">parent</item>
    </style>

    <style name="ConstraintLayout.Align.Center">
        <item name="layout_constraintTop_toTopOf">parent</item>
        <item name="layout_constraintBottom_toBottomOf">parent</item>
        <item name="layout_constraintStart_toStartOf">parent</item>
        <item name="layout_constraintEnd_toEndOf">parent</item>
    </style>

    <style name="ConstraintLayout.Align.CenterHorizontal">
        <item name="layout_constraintStart_toStartOf">parent</item>
        <item name="layout_constraintEnd_toEndOf">parent</item>
    </style>

    <style name="ConstraintLayout.Align.CenterVertical">
        <item name="layout_constraintTop_toTopOf">parent</item>
        <item name="layout_constraintBottom_toBottomOf">parent</item>
    </style>
</resources>