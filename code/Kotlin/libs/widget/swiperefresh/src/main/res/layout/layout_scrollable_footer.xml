<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    tools:ignore="MissingConstraints,HardcodedText,SpUsage">

    <TextView
        android:id="@+id/scrollable_footer_tv_reload_more"
        style="@style/ConstraintLayout.Match.Horizontal"
        android:layout_height="@dimen/scrollable_extend_height"
        android:gravity="center"
        android:text="加载失败，点击重试"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="gone" />

    <androidx.constraintlayout.widget.Group
        android:id="@+id/scrollable_footer_layout_loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="scrollable_footer_progress_view,scrollable_footer_tv_loading" />

    <vector.widget.ProgressView
        android:id="@+id/scrollable_footer_progress_view"
        android:layout_width="@dimen/scrollable_extend_loading_size"
        android:layout_height="@dimen/scrollable_extend_loading_size"
        android:src="@drawable/ic_loading"
        app:layout_constraintBottom_toBottomOf="@id/scrollable_footer_tv_loading"
        app:layout_constraintEnd_toStartOf="@id/scrollable_footer_tv_loading"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/scrollable_footer_tv_loading" />

    <TextView
        android:id="@+id/scrollable_footer_tv_loading"
        style="@style/ConstraintLayout.Align.TopRight"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/scrollable_extend_height"
        android:layout_marginStart="8dp"
        android:gravity="center"
        android:text="@string/swipe_refresh_hint_loading"
        android:textColor="@color/text_scrollable_header"
        android:textSize="@dimen/scrollable_extend_text"
        app:layout_constraintStart_toEndOf="@id/scrollable_footer_progress_view" />

</androidx.constraintlayout.widget.ConstraintLayout>