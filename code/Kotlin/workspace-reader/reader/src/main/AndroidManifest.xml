<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:name=".App"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="${app_name}"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.App.Default"
        tools:ignore="GoogleAppIndexingWarning,LockedOrientationActivity"
        tools:targetApi="n">
        <activity
            android:name=".pattern.activity.SplashActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.App.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".pattern.activity.MainActivity"
            android:launchMode="singleTask"
            android:screenOrientation="portrait" />
        <activity
            android:name=".pattern.activity.SearchActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".pattern.activity.BookInfoActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".pattern.activity.ReadActivity"
            android:launchMode="singleTop"
            android:screenOrientation="portrait" />
        <activity
            android:name=".pattern.activity.FontDisplayActivity"
            android:screenOrientation="portrait" />

        <service android:name=".serv.CacheServ" />

        <meta-data
            android:name="android.notch_support"
            android:value="true" />
    </application>

</manifest>