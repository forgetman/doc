<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="MissingConstraints,HardcodedText,SpUsage">

    <data>

        <variable
            name="viewHolder"
            type="reader.pattern.activity.ReadActivity.OptionCacheViewHolder" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_shadow_corner"
        android:view_visible="@{viewHolder.visible}">

        <TextView
            android:id="@+id/tv_title"
            style="@style/ConstraintLayout.Align.TopLeft"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_level_2"
            android:layout_marginTop="16dp"
            android:text="缓存多少章?"
            android:textColor="@color/text_primary"
            android:textSize="14dp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_title_caching"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/margin_level_2"
            android:text="@{viewHolder.caching}"
            android:textColor="@color/text_primary"
            android:textSize="12dp"
            app:layout_constraintBottom_toBottomOf="@id/tv_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tv_title"
            tools:text="缓存中: 1234/1234" />


        <View
            android:id="@+id/divider"
            style="@style/ConstraintLayout.Match.Horizontal"
            android:layout_width="0dp"
            android:layout_height="0.5dp"
            android:layout_marginStart="8dp"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="8dp"
            android:background="@color/divider"
            app:layout_constraintTop_toBottomOf="@id/tv_title" />

        <TextView
            android:id="@+id/tv_last_50"
            style="@style/View.Text.Read.Cache"
            android:layout_marginStart="@dimen/margin_level_2"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="@dimen/margin_level_2"
            android:text="50章"
            android:view_onClick="@{viewHolder.on50Click}"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/divider" />

        <TextView
            android:id="@+id/tv_last_all"
            style="@style/View.Text.Read.Cache"
            android:layout_marginStart="13dp"
            android:text="后面全部"
            android:view_onClick="@{viewHolder.onLastAllClick}"
            app:layout_constraintBottom_toBottomOf="@id/tv_last_50"
            app:layout_constraintStart_toEndOf="@id/tv_last_50"
            app:layout_constraintTop_toTopOf="@id/tv_last_50" />

        <TextView
            android:id="@+id/tv_all"
            style="@style/View.Text.Read.Cache"
            android:layout_marginStart="13dp"
            android:text="全部"
            android:view_onClick="@{viewHolder.onAllClick}"
            app:layout_constraintBottom_toBottomOf="@id/tv_last_all"
            app:layout_constraintStart_toEndOf="@id/tv_last_all"
            app:layout_constraintTop_toTopOf="@id/tv_last_all" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>