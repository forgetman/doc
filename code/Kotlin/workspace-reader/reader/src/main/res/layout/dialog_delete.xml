<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="MissingConstraints,HardcodedText,SpUsage">

    <data>

        <variable
            name="owner"
            type="reader.pattern.dialog.DeleteDialog" />
    </data>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="50dp"
            android:layout_marginEnd="50dp"
            android:background="@color/bg_primary"
            android:paddingTop="20dp"
            android:paddingBottom="20dp">

            <TextView
                android:id="@+id/tv_title"
                style="@style/ConstraintLayout.Match.Horizontal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="25dp"
                android:layout_marginTop="28dp"
                android:layout_marginEnd="25dp"
                android:text="是否删除书本?(将清除缓存)"
                android:textColor="@color/text_primary"
                android:textSize="16dp" />

            <TextView
                android:id="@+id/tv_cancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="15dp"
                android:background="@drawable/selector_primary"
                android:padding="6dp"
                android:text="否"
                android:textColor="@color/text_primary"
                android:textSize="17dp"
                android:view_onClick="@{owner.onCancelClick}"
                app:layout_constraintBottom_toBottomOf="@id/tv_delete"
                app:layout_constraintRight_toLeftOf="@id/tv_delete"
                app:layout_constraintTop_toTopOf="@id/tv_delete" />

            <TextView
                android:id="@+id/tv_delete"
                style="@style/ConstraintLayout.Align.Right"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_alignParentBottom="true"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="25dp"
                android:background="@drawable/selector_primary"
                android:padding="6dp"
                android:text="是"
                android:textColor="@color/text_f44"
                android:textSize="17dp"
                android:view_onClick="@{owner.onConfirmClick}"
                app:layout_constraintTop_toBottomOf="@id/tv_title" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>
</layout>