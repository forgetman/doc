<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="MissingConstraints,SpUsage">

    <data>

        <variable
            name="item"
            type="reader.model.Book" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <vector.widget.ImageView
            android:id="@+id/iv_cover"
            style="@style/ConstraintLayout.Align.TopLeft"
            android:layout_width="88dp"
            android:layout_height="128dp"
            android:layout_marginStart="@dimen/margin_level_1"
            android:layout_marginTop="@dimen/margin_level_1"
            android:imageView_placeholder="@{@drawable/book_ic_placeholder}"
            android:imageView_source="@{item.img}"
            android:imageView_transformation="@{item.ui.transformation}"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/tv_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_level_1"
            android:text="@{item.name}"
            android:textColor="@color/text_primary"
            android:textSize="16dp"
            android:textView_bold="@{true}"
            app:layout_constraintStart_toEndOf="@id/iv_cover"
            app:layout_constraintTop_toTopOf="@id/iv_cover"
            tools:text="书名" />

        <TextView
            android:id="@+id/tv_author"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_level_1"
            android:layout_marginTop="5dp"
            android:text="@{@string/author + item.author}"
            android:textColor="@color/text_secondary"
            android:textSize="10dp"
            app:layout_constraintStart_toEndOf="@id/iv_cover"
            app:layout_constraintTop_toBottomOf="@id/tv_name"
            tools:text="作者: XXX" />

        <TextView
            android:id="@+id/tv_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_level_1"
            android:layout_marginTop="5dp"
            android:text="@{@string/book_type + item.type}"
            android:textColor="@color/text_secondary"
            android:textSize="10dp"
            app:layout_constraintStart_toEndOf="@id/iv_cover"
            app:layout_constraintTop_toBottomOf="@id/tv_author"
            tools:text="类型: XXX" />

        <TextView
            android:id="@+id/tv_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_level_1"
            android:layout_marginTop="5dp"
            android:text="@{@string/book_status + item.status}"
            android:textColor="@color/text_secondary"
            android:textSize="10dp"
            app:layout_constraintStart_toEndOf="@id/iv_cover"
            app:layout_constraintTop_toBottomOf="@id/tv_type"
            tools:text="状态: XXX" />

        <TextView
            android:id="@+id/tv_update_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_level_1"
            android:layout_marginTop="5dp"
            android:text="@{@string/last_update_time + item.lastUpdateTime}"
            android:textColor="@color/text_secondary"
            android:textSize="10dp"
            app:layout_constraintStart_toEndOf="@id/iv_cover"
            app:layout_constraintTop_toBottomOf="@id/tv_status"
            tools:text="更新: XXX" />

        <TextView
            android:id="@+id/tv_newest_chapter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_level_1"
            android:layout_marginTop="5dp"
            android:text="@{@string/newest_chapter + item.newChapterDesc}"
            android:textColor="@color/blue"
            android:textSize="10dp"
            app:layout_constraintStart_toEndOf="@id/iv_cover"
            app:layout_constraintTop_toBottomOf="@id/tv_update_time"
            tools:text="最新章节: XXX" />

        <View
            android:id="@+id/layout_divider"
            style="@style/ConstraintLayout.Match.Horizontal"
            android:layout_height="1dp"
            android:layout_marginStart="@dimen/margin_level_1"
            android:layout_marginTop="@dimen/margin_level_1"
            android:layout_marginEnd="@dimen/margin_level_1"
            android:background="@color/divider"
            app:layout_constraintTop_toBottomOf="@id/iv_cover" />

        <TextView
            android:id="@+id/tv_intro_title"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginStart="@dimen/margin_level_1"
            android:gravity="center_vertical"
            android:text="简介"
            android:textColor="@color/text_primary"
            android:textSize="12dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layout_divider" />

        <View
            android:id="@+id/layout_divider2"
            style="@style/ConstraintLayout.Match.Horizontal"
            android:layout_height="@dimen/divider_height"
            android:background="@color/app_bg"
            app:layout_constraintTop_toBottomOf="@id/tv_intro_title" />

        <TextView
            android:id="@+id/tv_intro"
            style="@style/ConstraintLayout.Match.Horizontal"
            android:layout_marginStart="@dimen/margin_level_1"
            android:layout_marginTop="5dp"
            android:layout_marginEnd="@dimen/margin_level_1"
            android:text="@{item.intro}"
            android:textColor="@color/text_primary"
            android:textSize="10dp"
            app:layout_constraintTop_toBottomOf="@id/layout_divider2"
            tools:text="这是书本的简介" />

        <View
            android:id="@+id/layout_divider3"
            style="@style/ConstraintLayout.Match.Horizontal"
            android:layout_height="@dimen/divider_height"
            android:layout_marginTop="5dp"
            android:background="@color/app_bg"
            app:layout_constraintTop_toBottomOf="@id/tv_intro" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginStart="@dimen/margin_level_1"
            android:layout_marginBottom="@dimen/margin_level_1"
            android:gravity="center_vertical"
            android:text='@{item.author + " 还有以下书籍"}'
            android:textColor="@color/text_primary"
            android:textSize="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layout_divider3"
            tools:text="XX作者还有以下书籍" />
    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>