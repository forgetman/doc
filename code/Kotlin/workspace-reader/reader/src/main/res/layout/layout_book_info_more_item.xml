<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="MissingConstraints,SpUsage,HardcodedText">

    <data>

        <variable
            name="item"
            type="reader.model.Book" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <View
            style="@style/ConstraintLayout.Align.CenterHorizontal"
            android:layout_width="110dp"
            android:layout_height="148dp"
            android:layout_marginTop="-8dp"
            android:background="@drawable/bookshelf_bg_cover"
            app:layout_constraintTop_toTopOf="parent" />

        <vector.widget.ImageView
            android:id="@+id/iv_cover"
            style="@style/ConstraintLayout.Align.CenterHorizontal"
            android:layout_width="88dp"
            android:layout_height="128dp"
            android:imageView_placeholder="@{@drawable/book_ic_placeholder}"
            android:imageView_source="@{item.img}"
            android:imageView_transformation="@{item.ui.transformation}"
            android:scaleType="centerCrop"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/layout_placeholder"
            style="@style/ConstraintLayout.Match.Horizontal"
            android:layout_width="0dp"
            android:layout_height="63dp"
            app:layout_constraintTop_toBottomOf="@id/iv_cover" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="@{item.name}"
            android:textColor="@color/text_primary"
            android:textSize="12dp"
            app:layout_constraintEnd_toEndOf="@id/iv_cover"
            app:layout_constraintStart_toStartOf="@id/iv_cover"
            app:layout_constraintTop_toBottomOf="@id/iv_cover"
            tools:text="这是书名" />
    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>
