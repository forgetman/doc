<?xml version="1.0" encoding="utf-8"?>
<!--suppress AndroidUnknownAttribute -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="MissingConstraints,HardcodedText">

    <data>

        <variable
            name="owner"
            type="reader.pattern.activity.MainActivity" />

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <vector.widget.viewpager.ViewPager
            style="@style/ConstraintLayout.Match.Horizontal"
            android:layout_height="0dp"
            android:viewPager_currentItem="@={owner.currIndex}"
            android:viewPager_offscreenPageLimit="@{owner.pager.size}"
            android:viewPager_fragPager="@{owner.pager}"
            android:viewPager_scrollable="@{false}"
            android:viewPager_smoothScroll="@{false}"
            app:layout_constraintBottom_toTopOf="@id/main_layout_group"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            style="@style/ConstraintLayout.Match.Horizontal"
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:background="@drawable/ic_shadow"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintBottom_toTopOf="@id/main_layout_group" />

        <RadioGroup
            android:id="@+id/main_layout_group"
            style="@style/ConstraintLayout.Match.Horizontal"
            android:layout_height="54dp"
            android:orientation="horizontal"
            android:radioGroup_checked="@={owner.currIndex}"
            app:layout_constraintBottom_toBottomOf="parent">

            <RadioButton
                android:id="@+id/main_tv_tab_shelf"
                style="@style/View.Text.MainTab"
                android:drawableTop="@drawable/selector_main_bookshelf"
                android:text="书架" />

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:background="@color/divider" />

            <RadioButton
                android:id="@+id/main_tv_tab_city"
                style="@style/View.Text.MainTab"
                android:drawableTop="@drawable/selector_main_book_city"
                android:text="书城" />
        </RadioGroup>

    </androidx.constraintlayout.widget.ConstraintLayout>


</layout>
