<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="MissingConstraints,HardcodedText,SpUsage,ContentDescription">

    <data>

        <variable
            name="viewHolder"
            type="reader.pattern.activity.ReadActivity.OptionSetupViewHolder" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_shadow_corner"
        android:clickable="true"
        android:focusable="true"
        android:view_visible="@{viewHolder.visible}">

        <TextView
            android:id="@+id/tv_size_minus"
            style="@style/ConstraintLayout.Align.TopLeft"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="30dp"
            android:layout_marginTop="21dp"
            android:text="A-"
            android:textColor="@color/text_primary"
            android:textSize="14dp"
            android:view_onClick="@{viewHolder.onFontSizeMinusClick}" />

        <reader.widget.FontAdjustView
            android:id="@+id/layout_font_adjust"
            android:layout_width="0dp"
            android:layout_height="20dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            app:layout_constraintBottom_toBottomOf="@id/tv_size_minus"
            app:layout_constraintEnd_toStartOf="@id/tv_size_plus"
            app:layout_constraintStart_toEndOf="@id/tv_size_minus" />

        <TextView
            android:id="@+id/tv_size_plus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="30dp"
            android:text="A+"
            android:textColor="@color/text_primary"
            android:textSize="20dp"
            android:view_onClick="@{viewHolder.onFontSizePlusClick}"
            app:layout_constraintBottom_toBottomOf="@id/tv_size_minus"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tv_size_minus" />

        <androidx.constraintlayout.helper.widget.Flow
            android:id="@+id/flow_line_spacing"
            style="@style/ConstraintLayout.Match.Horizontal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_level_2"
            android:layout_marginTop="33dp"
            android:layout_marginEnd="@dimen/margin_level_2"
            app:constraint_referenced_ids="iv_space_3,iv_space_2,iv_space_1,tv_font"
            app:layout_constraintTop_toBottomOf="@id/layout_font_adjust" />

        <ImageView
            android:id="@+id/iv_space_3"
            android:layout_width="74dp"
            android:layout_height="24dp"
            android:background="@drawable/selector_read_setup_bg_space"
            android:scaleType="centerInside"
            android:src="@drawable/read_ic_setup_text_space_3"
            android:view_onClick="@{viewHolder.onLineSpacing3Click}" />

        <ImageView
            android:id="@+id/iv_space_2"
            android:layout_width="74dp"
            android:layout_height="24dp"
            android:background="@drawable/selector_read_setup_bg_space"
            android:scaleType="centerInside"
            android:src="@drawable/read_ic_setup_text_space_2"
            android:view_onClick="@{viewHolder.onLineSpacing2Click}" />

        <ImageView
            android:id="@+id/iv_space_1"
            android:layout_width="74dp"
            android:layout_height="24dp"
            android:background="@drawable/selector_read_setup_bg_space"
            android:scaleType="centerInside"
            android:src="@drawable/read_ic_setup_text_space_1"
            android:view_onClick="@{viewHolder.onLineSpacing1Click}" />


        <TextView
            android:id="@+id/tv_font"
            style="@style/View.Text.Read.Cache"
            android:layout_marginStart="10dp"
            android:text="字体"
            android:view_onClick="@{viewHolder.onFontStyleClick}" />

        <TextView
            android:id="@+id/tv_next_page"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_level_2"
            android:layout_marginTop="26dp"
            android:layout_marginBottom="24dp"
            android:text="点击左侧翻下一页"
            android:textColor="@color/text_primary"
            android:textSize="14dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/flow_line_spacing" />

        <vector.widget.ToggleButton
            style="@style/View.Button.ToggleButton"
            android:layout_marginEnd="@dimen/margin_level_2"
            android:toggleButton_checked="@={viewHolder.clickLeftChecked}"
            app:layout_constraintBottom_toBottomOf="@id/tv_next_page"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tv_next_page" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>