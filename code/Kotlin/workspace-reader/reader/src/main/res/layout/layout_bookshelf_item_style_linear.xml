<?xml version="1.0" encoding="utf-8"?>
<!--suppress AndroidUnknownAttribute -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="SpUsage,MissingConstraints,HardcodedText">

    <data>

        <variable
            name="item"
            type="reader.pattern.adapter.BookshelfAdapter.Linear" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/selector_primary">

        <vector.widget.ImageView
            android:id="@+id/iv_cover"
            style="@style/ConstraintLayout.Align.TopLeft"
            android:layout_width="88dp"
            android:layout_height="128dp"
            android:layout_marginStart="26dp"
            android:layout_marginTop="@{item.marginTop}"
            android:imageView_placeholder="@{@drawable/book_ic_placeholder}"
            android:imageView_source="@{item.book.img}"
            android:imageView_transformation="@{item.book.ui.transformation}"
            android:scaleType="centerCrop"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:background="@color/blue"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:text="@{item.book.status}"
            android:textColor="@color/white"
            android:textSize="8dp"
            android:view_visible="@{item.book.ui.statusVisible}"
            app:layout_constraintEnd_toEndOf="@id/iv_cover"
            app:layout_constraintTop_toTopOf="@id/iv_cover"
            tools:text="完结" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:background="@color/btn_bg_red"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:text="更新"
            android:textColor="@color/white"
            android:textSize="8dp"
            android:view_visible="@{item.book.ui.hasNewChapters}"
            app:layout_constraintStart_toStartOf="@id/iv_cover"
            app:layout_constraintTop_toTopOf="@id/iv_cover" />

        <TextView
            android:id="@+id/tv_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginTop="17dp"
            android:text="@{item.book.name}"
            android:textColor="@color/text_primary"
            android:textSize="16dp"
            android:textView_bold="@{true}"
            app:layout_constraintStart_toEndOf="@id/iv_cover"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="我的治愈系游戏" />

        <TextView
            android:id="@+id/tv_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@{@string/book_type + item.book.type}"
            android:textColor="@color/text_secondary"
            android:textSize="13dp"
            app:layout_constraintStart_toStartOf="@id/tv_name"
            app:layout_constraintTop_toBottomOf="@id/tv_name"
            tools:text="类型: 仙侠" />

        <TextView
            android:id="@+id/tv_read"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="@{@string/read_chapter + item.book.ui.currReadIndex}"
            android:textColor="@color/text_secondary"
            android:textSize="13dp"
            app:layout_constraintStart_toStartOf="@id/tv_name"
            app:layout_constraintTop_toBottomOf="@id/tv_type"
            tools:text="章节: 123/1000" />

        <TextView
            android:id="@+id/tv_newest_chapter"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:layout_marginEnd="26dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@{@string/newest_chapter + item.book.lastChapterDesc}"
            android:textColor="@color/text_secondary"
            android:textSize="13dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/tv_name"
            app:layout_constraintTop_toBottomOf="@id/tv_read"
            tools:text="最新章节: XXX" />

        <TextView
            android:id="@+id/tv_intro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_level_2"
            android:text="@{@string/author + item.book.author}"
            android:textColor="@color/text_secondary"
            android:textSize="12dp"
            app:layout_constraintStart_toStartOf="@id/tv_name"
            app:layout_constraintTop_toBottomOf="@id/tv_newest_chapter"
            tools:text="作者: XXX" />

        <com.airbnb.lottie.LottieAnimationView
            style="@style/ConstraintLayout.Align.TopRight"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:lottie_visibility="@{item.book.ui.updateState}"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"
            app:lottie_rawRes="@raw/lottie_book_updating" />

        <View
            style="@style/ConstraintLayout.Match.Horizontal"
            android:layout_height="0.5dp"
            android:layout_marginStart="8dp"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="8dp"
            android:background="@color/divider"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/iv_cover" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>
