<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="MissingConstraints,HardcodedText,SpUsage">

    <data>

        <variable
            name="owner"
            type="reader.pattern.frag.leaderboard.LeaderboardFrag" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <RadioGroup
            android:id="@+id/layout_radio_group"
            style="@style/ConstraintLayout.Match.Horizontal"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_level_1"
            android:orientation="horizontal"
            android:radioGroup_checked="@={owner.currIndex}"
            app:layout_constraintTop_toTopOf="parent">

            <RadioButton
                style="@style/View.Text.LeaderboardTab"
                android:text="周榜"
                tools:checked="true" />

            <RadioButton
                style="@style/View.Text.LeaderboardTab"
                android:layout_marginStart="2dp"
                android:text="月榜" />

            <RadioButton
                style="@style/View.Text.LeaderboardTab"
                android:layout_marginStart="2dp"
                android:text="总榜" />
        </RadioGroup>

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/frag_sub"
            style="@style/ConstraintLayout.Match.Horizontal"
            android:layout_height="0dp"
            android:layout_marginTop="7dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layout_radio_group" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>