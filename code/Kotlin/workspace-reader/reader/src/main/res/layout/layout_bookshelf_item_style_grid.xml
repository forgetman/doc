<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="MissingConstraints,SpUsage,HardcodedText">

    <data>

        <variable
            name="item"
            type="reader.model.Book" />

        <import type="android.view.View" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <View
            style="@style/ConstraintLayout.Align.CenterHorizontal"
            android:layout_width="110dp"
            android:layout_height="148dp"
            android:layout_marginTop="-8dp"
            android:background="@drawable/bookshelf_bg_cover"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/iv_cover"
            style="@style/ConstraintLayout.Align.CenterHorizontal"
            android:layout_width="88dp"
            android:layout_height="128dp"
            android:imageView_placeholder="@{@drawable/book_ic_placeholder}"
            android:imageView_source="@{item.img}"
            android:imageView_transformation="@{item.ui.transformation}"
            android:scaleType="centerCrop"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            style="@style/ConstraintLayout.Align.CenterHorizontal"
            android:layout_width="0dp"
            android:background="@drawable/shape_bookshelf_grid_bg_chapter"
            android:gravity="center"
            android:text="@{item.ui.currReadIndex}"
            android:textColor="@color/white"
            android:textSize="10dp"
            app:layout_constraintBottom_toBottomOf="@id/iv_cover"
            app:layout_constraintEnd_toEndOf="@id/iv_cover"
            app:layout_constraintStart_toStartOf="@id/iv_cover"
            tools:text="123/1002" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/radius"
            android:background="@color/blue"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:text="@{item.status}"
            android:textColor="@color/white"
            android:textSize="8dp"
            android:view_visible="@{item.ui.statusVisible}"
            app:layout_constraintEnd_toEndOf="@id/iv_cover"
            app:layout_constraintTop_toTopOf="@id/iv_cover"
            tools:text="完结" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/radius"
            android:background="@color/btn_bg_red"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:text="更新"
            android:textColor="@color/white"
            android:textSize="8dp"
            android:view_visible="@{item.ui.hasNewChapters}"
            app:layout_constraintStart_toStartOf="@id/iv_cover"
            app:layout_constraintTop_toTopOf="@id/iv_cover" />

        <com.airbnb.lottie.LottieAnimationView xmlns:lottie="http://schemas.android.com/apk/res-auto"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:lottie_visibility="@{item.ui.updateState}"
            lottie:layout_constraintEnd_toEndOf="@id/iv_cover"
            lottie:layout_constraintTop_toTopOf="parent"
            lottie:lottie_autoPlay="true"
            lottie:lottie_loop="true"
            lottie:lottie_rawRes="@raw/lottie_book_updating" />

        <View
            android:id="@+id/layout_placeholder"
            style="@style/ConstraintLayout.Match.Horizontal"
            android:layout_width="0dp"
            android:layout_height="63dp"
            app:layout_constraintTop_toBottomOf="@id/iv_cover" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="@{item.name}"
            android:textColor="@color/text_primary"
            android:textSize="12dp"
            app:layout_constraintEnd_toEndOf="@id/iv_cover"
            app:layout_constraintStart_toStartOf="@id/iv_cover"
            app:layout_constraintTop_toBottomOf="@id/iv_cover"
            tools:text="这是书名" />
    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>
