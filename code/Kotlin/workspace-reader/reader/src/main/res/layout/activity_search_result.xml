<?xml version="1.0" encoding="utf-8"?>
<!--suppress AndroidUnknownAttribute -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="MissingConstraints,HardcodedText">

    <data>

        <variable
            name="owner"
            type="reader.pattern.activity.SearchActivity" />

        <variable
            name="viewModel"
            type="reader.pattern.viewModel.SearchResultViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            style="@style/ConstraintLayout.Match.All"
            android:refresh_onSwipe="@{owner.onSwipe}"
            tools:visibility="visible">

            <vector.widget.scrollable.ListView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:listView_itemBinder="@{owner.itemBinder}"
                android:listView_itemData="@{viewModel.books}"
                android:listView_onItemClick="@{viewModel.onItemClick}"
                android:view_visible="@{viewModel.showResult}"
                tools:listitem="@layout/layout_leaderboard_item" />
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <androidx.constraintlayout.widget.Group
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:view_visible="@{!viewModel.showResult}"
            app:constraint_referenced_ids="tv_hot_author,layout_lv_hots"
            tools:visibility="gone" />

        <TextView
            android:id="@+id/tv_hot_author"
            style="@style/ConstraintLayout.Align.TopLeft"
            android:layout_width="wrap_content"
            android:layout_marginStart="@dimen/margin_level_1"
            android:text="热门作者"
            android:textColor="#979797" />

        <vector.widget.scrollable.ListView
            android:id="@+id/layout_lv_hots"
            style="@style/ConstraintLayout.Match.Horizontal"
            android:layout_height="0dp"
            android:layout_marginStart="@dimen/margin_level_1"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="@dimen/margin_level_1"
            android:listView_itemBinder="@{owner.hotItemBinder}"
            android:listView_itemData="@{viewModel.hots}"
            android:listView_layoutManager="@{owner.hotLayoutManager}"
            android:listView_onItemClick="@{viewModel.onHotItemClick}"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_hot_author"
            tools:listitem="@layout/layout_search_hot_item" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>