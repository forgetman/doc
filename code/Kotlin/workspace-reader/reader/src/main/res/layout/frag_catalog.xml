<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="HardcodedText,SpUsage,MissingConstraints">

    <data>

        <variable
            name="owner"
            type="reader.pattern.frag.CatalogFrag" />

        <import type="vector.widget.scrollable.adapter.ItemCompare" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_title_container"
            style="@style/ConstraintLayout.Match.Horizontal"
            android:layout_height="wrap_content"
            android:layout_marginTop="@{owner.topMargin}"
            android:background="@drawable/shape_chapter_title"
            android:paddingTop="@dimen/margin_level_2"
            android:paddingBottom="14dp"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tv_menu"
                style="@style/ConstraintLayout.Align.Left"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="50dp"
                android:text="目录"
                android:textColor="@color/text_primary"
                android:textSize="16dp" />

            <TextView
                android:id="@+id/tv_to_top"
                style="@style/View.Text.Catalog.Title"
                android:layout_marginEnd="28dp"
                android:layout_toStartOf="@id/tv_to_bottom"
                android:text="顶部"
                android:view_onClick="@{owner.onToTopClick}"
                app:drawableEndCompat="@drawable/catalog_ic_up"
                app:layout_constraintBottom_toBottomOf="@id/tv_menu"
                app:layout_constraintEnd_toStartOf="@id/tv_to_bottom"
                app:layout_constraintTop_toTopOf="@id/tv_menu" />

            <TextView
                android:id="@+id/tv_to_bottom"
                style="@style/View.Text.Catalog.Title"
                android:layout_marginEnd="50dp"
                android:text="底部"
                android:view_onClick="@{owner.onToBottomClick}"
                app:drawableEndCompat="@drawable/catalog_ic_down"
                app:layout_constraintBottom_toBottomOf="@id/tv_menu"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/tv_menu" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <vector.widget.scrollable.ListView
            style="@style/ConstraintLayout.Match.Horizontal"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@color/bg_primary"
            android:listView_decoration="@{owner.decoration}"
            android:listView_itemBinder="@{owner.itemBinder}"
            android:listView_itemCompare="@{ItemCompare.DATASET_CHANGED}"
            android:listView_itemData="@{owner.data}"
            android:listView_onItemClick="@{owner.onItemClick}"
            android:listView_trigger="@{owner.trigger}"
            android:scrollbars="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layout_title_container"
            tools:listitem="@layout/layout_chapter_item" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>