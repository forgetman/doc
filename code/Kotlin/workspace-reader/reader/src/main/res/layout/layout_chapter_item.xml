<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="item"
            type="reader.model.Chapter" />

        <import type="android.view.View" />
    </data>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@drawable/selector_primary"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/margin_level_2"
        android:paddingEnd="@dimen/margin_level_2"
        android:singleLine="true"
        android:text="@{item.name}"
        android:textColor="@color/selector_chapter_text"
        android:textSize="16dp"
        android:view_isSelected="@{item.focus}"
        tools:text="章节名称" />

</layout>