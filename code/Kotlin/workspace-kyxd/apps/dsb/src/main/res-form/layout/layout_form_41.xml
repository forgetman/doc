<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">

    <data>

        <variable
            name="item"
            type="lib.base.model.Form" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout style="@style/View.Form.Me">

            <vector.widget.ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:imageView_source="@{item.icon}" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/margin"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:text="@{item.title}"
                android:textColor="@color/text_21"
                android:textSize="14dp" />

            <ImageView style="@style/View.Image.Arrow.AlignRight" />
        </LinearLayout>

        <View style="@style/View.Divider" />
    </LinearLayout>
</layout>