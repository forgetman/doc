<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="View.Edit.Form">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textSize">13dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">@color/text_21</item>
        <item name="android:textColorHint">@color/text_ba</item>
        <item name="android:layout_marginStart">21dp</item>
        <item name="android:textCursorDrawable">@drawable/shape_edit_text_cursor</item>
        <item name="android:background">@drawable/transparent</item>
    </style>

    <style name="View.Edit.Form.Comment">
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:layout_marginEnd">16dp</item>
        <item name="android:layout_marginBottom">12dp</item>
        <item name="android:padding">8dp</item>
        <item name="android:gravity">top</item>
        <item name="android:background">@drawable/bg_comment_et</item>
    </style>
</resources>