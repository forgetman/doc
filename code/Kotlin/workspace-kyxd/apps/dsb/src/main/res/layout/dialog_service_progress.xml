<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">

    <data>

        <variable
            name="owner"
            type="dsb.design.ui.dialog.ServiceProgressDialog" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_white_corner"
        android:orientation="vertical"
        android:paddingStart="@dimen/margin"
        android:paddingEnd="@dimen/margin">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="50dp"
                android:layout_centerInParent="true"
                android:gravity="center"
                android:text="服务进度"
                android:textColor="@color/text_444"
                android:textSize="16dp" />

            <ImageView
                android:layout_width="27dp"
                android:layout_height="27dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/selector_bg_item_transparent"
                android:padding="7dp"
                android:src="@drawable/nav_bar_ic_close"
                android:view_onClick="@{owner.onCloseClick}" />
        </RelativeLayout>

        <View style="@style/View.Divider" />

        <vector.scrollable.widget.GroupListView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="22dp"
            android:groupListView_adapter="@{owner.adapter}"
            android:groupListView_data="@{owner.data}"
            android:groupListView_divider="@{null}"
            android:groupListView_floatGroup="@{false}" />
    </LinearLayout>
</layout>