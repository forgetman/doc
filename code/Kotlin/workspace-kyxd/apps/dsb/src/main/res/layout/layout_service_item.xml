<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="SpUsage,HardcodedText">

    <data>

        <variable
            name="item"
            type="dsb.model.Service" />

        <variable
            name="listener"
            type="dsb.design.ui.itembinder.Services.ItemBinder.Data.Listener" />
    </data>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/service_item_bg"
        android:orientation="vertical"
        android:paddingStart="@dimen/margin"
        android:paddingEnd="@dimen/margin"
        android:paddingBottom="8dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin"
            android:layout_marginTop="@dimen/margin"
            android:layout_marginEnd="@dimen/margin">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_97"
                android:textSize="14dp"
                tools:text="社保公积金/个人服务" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:textColor="@color/text_97"
                android:textSize="12dp"
                tools:text="2020/5/13 14:50: 00" />
        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="16dp"
            android:layout_marginTop="5dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/shape_service_dash" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin"
            android:layout_marginTop="9dp"
            android:text="委托服务"
            android:textColor="@color/text_444"
            android:textSize="12dp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="@dimen/margin"
            android:layout_marginTop="9dp"
            android:layout_marginEnd="@dimen/margin"
            android:layout_weight="1"
            android:background="@drawable/shape_service_dash" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin"
            android:layout_marginTop="9dp"
            android:layout_marginEnd="@dimen/margin"
            android:text="补缴阿斯顿发撒旦法撒旦法撒旦法"
            android:textColor="@color/text_97"
            android:textSize="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="@dimen/margin"
            android:layout_marginBottom="16dp"
            android:gravity="center_vertical|end"
            android:orientation="horizontal">

            <TextView
                android:layout_width="90dp"
                android:layout_height="match_parent"
                android:background="@drawable/selector_bg_blue_border"
                android:gravity="center"
                android:onClick="@{() -> listener.onDetailClick(item)}"
                android:text="订单明细"
                android:textColor="@color/blue"
                android:textSize="12dp" />

            <TextView
                android:layout_width="90dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:background="@drawable/selector_bg_green_border"
                android:gravity="center"
                android:onClick="@{() -> listener.onProgressClick(item)}"
                android:text="查看服务进度"
                android:textColor="@color/green"
                android:textSize="12dp" />
        </LinearLayout>
    </LinearLayout>

</layout>