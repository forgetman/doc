<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">

    <data>

        <variable
            name="owner"
            type="dsb.design.ui.dialog.LogoutConfirmDialog" />

    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:orientation="vertical"
        android:paddingStart="@dimen/margin"
        android:paddingEnd="@dimen/margin">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_vertical">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_centerVertical="true"
                android:src="@drawable/logout_confirm_ic_close"
                android:view_onClick="@{owner.onCloseClick}" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="输入短信验证码"
                android:textColor="@color/text_333"
                android:textSize="15dp" />
        </RelativeLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@{owner.text}" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="33dp"
            android:layout_marginTop="7dp"
            android:orientation="horizontal">

            <EditText
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_logout_confirm_et"
                android:hint="获取验证码"
                android:paddingStart="10dp"
                android:text="@={owner.captcha}"
                android:textColor="@color/text_333"
                android:textColorHint="@color/text_75"
                android:textSize="12dp" />

            <dsb.view.CaptchaView
                android:layout_width="89dp"
                android:layout_height="match_parent"
                android:layout_weight="0"
                android:background="@drawable/selector_bg_blue"
                android:captchaView_countdownStart="@{owner.startCountdown}"
                android:gravity="center"
                android:text="获取验证码"
                android:textColor="@color/white"
                android:textSize="13dp"
                android:view_onClick="@{owner.onCaptchaClick}" />
        </LinearLayout>

        <TextView
            android:layout_width="200dp"
            android:layout_height="33dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="34dp"
            android:background="@drawable/selector_bg_blue_corner_2"
            android:enabled="@{owner.confirmEnable}"
            android:gravity="center"
            android:text="确认注销"
            android:textColor="@color/white"
            android:textSize="13dp"
            android:view_onClick="@{owner.onConfirmClick}" />


    </LinearLayout>
</layout>