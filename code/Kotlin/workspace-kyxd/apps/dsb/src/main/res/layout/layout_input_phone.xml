<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">

    <data>

        <variable
            name="input"
            type="dsb.model.Input" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout style="@style/View.Login">

            <TextView
                style="@style/View.Text.Login.Name"
                android:text="手机号" />

            <EditText
                style="@style/View.Edit.Login"
                android:hint="请输入有效手机号"
                android:text="@={input.phone}" />
        </LinearLayout>

        <LinearLayout style="@style/View.Login">

            <TextView
                style="@style/View.Text.Login.Name"
                android:text="验证码" />

            <EditText
                style="@style/View.Edit.Login"
                android:hint="请输入验证码"
                android:inputType="number"
                android:text="@={input.captcha}" />

            <dsb.view.CaptchaView
                android:layout_width="86dp"
                android:layout_height="27dp"
                android:layout_marginStart="@dimen/margin"
                android:layout_weight="0"
                android:background="@drawable/selector_bg_blue_corner"
                android:captchaView_countdownStart="@{input.startCountdown}"
                android:gravity="center"
                android:text="获取验证码"
                android:textColor="@color/white"
                android:textSize="13dp"
                android:view_onClick="@{input.onCaptchaClick}" />
        </LinearLayout>

    </LinearLayout>
</layout>