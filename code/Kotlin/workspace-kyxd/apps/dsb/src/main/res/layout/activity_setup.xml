<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">

    <data>

        <variable
            name="owner"
            type="dsb.design.ui.activity.SetupActivity" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:layout_width="41dp"
                android:layout_height="41dp"
                android:layout_marginTop="34dp"
                android:src="@mipmap/ic_launcher" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="34dp"
                android:text="@{owner.version}"
                android:textColor="@color/text_21"
                android:textSize="13dp" />

        </LinearLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="43dp"
            android:background="@drawable/selector_bg_item"
            android:orientation="horizontal"
            android:paddingStart="@dimen/margin"
            android:paddingEnd="@dimen/margin"
            android:view_onClick="@{owner.onClick}">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:drawablePadding="@dimen/margin"
                android:gravity="center"
                android:text="服务协议"
                android:textColor="@color/text_21"
                android:textSize="14dp" />

            <ImageView style="@style/View.Image.Arrow.AlignRight" />
        </RelativeLayout>

        <View style="@style/View.Divider" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="43dp"
            android:background="@drawable/selector_bg_item"
            android:orientation="horizontal"
            android:paddingStart="@dimen/margin"
            android:paddingEnd="@dimen/margin"
            android:view_onClick="@{owner.onLogoutClick}"
            android:view_visible="@{owner.signOutVisibility}">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:drawablePadding="@dimen/margin"
                android:gravity="center"
                android:text="注销账号"
                android:textColor="@color/text_21"
                android:textSize="14dp" />

            <ImageView style="@style/View.Image.Arrow.AlignRight" />
        </RelativeLayout>

        <View style="@style/View.Divider" />

        <TextView
            android:layout_width="200dp"
            android:layout_height="33dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="67dp"
            android:background="@drawable/selector_bg_blue_corner_2"
            android:gravity="center"
            android:text="退出登录"
            android:textColor="@color/white"
            android:textSize="13dp"
            android:view_onClick="@{owner.onSignOutClick}"
            android:view_visible="@{owner.signOutVisibility}" />

    </LinearLayout>

</layout>