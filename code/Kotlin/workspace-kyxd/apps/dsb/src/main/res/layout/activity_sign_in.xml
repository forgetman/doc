<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:bind="http://schemas.android.com/apk/res-auto">

    <data>

        <variable
            name="owner"
            type="dsb.design.ui.activity.SignInActivity" />

        <variable
            name="viewModel"
            type="dsb.design.viewModel.SignInViewModel" />

        <variable
            name="input"
            type="dsb.model.Input" />
    </data>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="true"
        android:focusableInTouchMode="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <include
                layout="@layout/layout_input_phone"
                bind:input="@{input}" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginStart="@dimen/margin"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="@dimen/margin"
                android:background="@drawable/selector_bg_blue"
                android:gravity="center"
                android:text="登录"
                android:textColor="@color/white"
                android:textSize="16dp"
                android:view_onClick="@{owner.onLoginClick}" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="right"
                android:layout_marginTop="@dimen/margin_vertical"
                android:layout_marginEnd="@dimen/margin"
                android:gravity="right"
                android:text="收不到短信?试试语音验证码"
                android:textColor="#ff0000"
                android:textSize="12dp"
                android:view_onClick="@{owner.onVoiceCaptchaClick}" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    style="@style/View.Divider"
                    android:layout_height="1dp"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="25dp"
                    android:layout_weight="1"
                    android:background="#a6a6a6" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="0"
                    android:text="第三方登录"
                    android:textColor="@color/text_888"
                    android:textSize="14dp" />

                <View
                    style="@style/View.Divider"
                    android:layout_height="1dp"
                    android:layout_marginStart="25dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="#a6a6a6" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginStart="@dimen/margin"
                android:layout_marginTop="25dp"
                android:layout_marginEnd="@dimen/margin"
                android:layout_marginBottom="25dp"
                android:background="@drawable/selector_bg_green_border"
                android:gravity="center"
                android:view_onClick="@{owner.onWxLogin}">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/ic_wx"
                    android:drawablePadding="13dp"
                    android:gravity="center"
                    android:text="微信登录"
                    android:textColor="#71c100"
                    android:textSize="13dp" />
            </LinearLayout>
        </LinearLayout>

    </RelativeLayout>
</layout>