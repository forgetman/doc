<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">

    <data>

        <variable
            name="owner"
            type="dsb.design.ui.activity.MainActivity" />
    </data>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <vector.viewpager.widget.ViewPager
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:viewPager_currentItem="@{owner.tabSelected}"
                android:viewPager_offscreenPageLimit="@{owner.pager.size}"
                android:viewPager_fragPager="@{owner.pager}"
                android:viewPager_scrollable="@{false}"
                android:viewPager_smoothScroll="@{false}" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:layout_weight="0"
                android:background="#928d8a" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_weight="0"
                android:orientation="horizontal">

                <TextView
                    style="@style/View.Text.Main.Tab"
                    android:drawableTop="@drawable/selector_main_tab_home"
                    android:text="首页"
                    android:view_isSelected="@{owner.tabSelected == 0}"
                    android:view_onClick="@{owner.onMainTab}" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="1">

                    <TextView
                        style="@style/View.Text.Main.Tab"
                        android:drawableTop="@drawable/selector_main_tab_msg"
                        android:text="消息"
                        android:view_isSelected="@{owner.tabSelected == 1}"
                        android:view_onClick="@{owner.onMsgTab}" />

                    <View
                        android:layout_width="4dp"
                        android:layout_height="4dp"
                        android:layout_alignParentEnd="true"
                        android:layout_marginTop="6dp"
                        android:layout_marginEnd="24dp"
                        android:background="@drawable/shape_red_dot"
                        android:view_visible="@{owner.unreadCount != 0}" />
                </RelativeLayout>

                <View style="@style/View.Text.Main.Tab" />

                <TextView
                    style="@style/View.Text.Main.Tab"
                    android:drawableTop="@drawable/selector_main_tab_info"
                    android:text="资讯"
                    android:view_isSelected="@{owner.tabSelected == 2}"
                    android:view_onClick="@{owner.onInfoTab}" />

                <TextView
                    style="@style/View.Text.Main.Tab"
                    android:drawableTop="@drawable/selector_main_tab_me"
                    android:text="我的"
                    android:view_isSelected="@{owner.tabSelected == 3}"
                    android:view_onClick="@{owner.onMeTab}" />
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:layout_width="44dp"
            android:layout_height="47dp"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="6dp"
            android:src="@drawable/main_tab_ic_serv"
            android:view_onClick="@{owner.onChatClick}" />

    </RelativeLayout>
</layout>