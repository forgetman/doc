<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">

    <data>

        <variable
            name="viewModel"
            type="fund.design.viewModel.TestViewModel" />

        <variable
            name="owner"
            type="fund.design.ui.activity.TestActivity" />
    </data>

    <vector.widget.scrollable.ListView
        android:listView_adapter="@{owner.adapter}"
        android:listView_itemData="@{viewModel.list}"
        android:listView_onItemClick="@{viewModel.onClick}"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</layout>