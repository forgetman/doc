<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">

    <data>

        <variable
            name="input"
            type="fund.model.InputInfo" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="23dp"
        android:paddingEnd="23dp">

        <EditText
            style="@style/profile.et"
            android:layout_marginTop="46dp"
            android:editText_onTextChanged="@{input.onPhoneTextChanged}"
            android:hint="请输入手机号"
            android:inputType="number" />

        <View style="@style/profile.line" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical">

            <EditText
                style="@style/profile.et"
                android:layout_weight="1"
                android:editText_onTextChanged="@{input.onCaptchaTextChanged}"
                android:hint="请输入验证码"
                android:inputType="number" />

            <vector.view.CaptchaView
                android:id="@+id/phone_input_tv_captcha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="0"
                android:text="获取验证码"
                android:textColor="@color/blue"
                android:textSize="15dp" />

        </LinearLayout>

        <View style="@style/profile.line" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginTop="30dp"
            android:background="@drawable/shape_purple_blue_gradient"
            android:gravity="center"
            android:text="绑定手机号"
            android:textColor="@color/white"
            android:textSize="15dp"
            android:view_onClick="@{input.onActionClick}" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="right"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="收不到？试试"
                android:textColor="@color/text_75"
                android:textSize="13dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="语音验证码"
                android:textColor="@color/red"
                android:textSize="13dp"
                android:view_onClick="@{input.onVoiceClick}" />

        </LinearLayout>

    </LinearLayout>
</layout>