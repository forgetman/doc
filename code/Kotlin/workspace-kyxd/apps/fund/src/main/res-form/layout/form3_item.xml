<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/item_selector">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <vector.image.NImageView
            android:id="@+id/form_niv"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginStart="20dp"
            android:layout_weight="0" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="20dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/form_tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="读秒"
                android:textColor="@color/text_2B"
                android:textSize="15dp" />

            <TextView
                android:id="@+id/form_tv_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="直接对接信贷经理"
                android:textColor="@color/text_75"
                android:textSize="13dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/form_tv_range"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/gap_horizontal"
            android:layout_weight="0"
            android:text="0.3~25万"
            android:textColor="@color/red"
            android:textSize="14dp" />

    </LinearLayout>

    <View style="@style/divider" />

</FrameLayout>

