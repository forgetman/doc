<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/item_selector"
    android:paddingStart="@dimen/gap_horizontal"
    android:paddingEnd="@dimen/gap_horizontal">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="95dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/form_tv_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="17dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="休息日参加asdf asasdasdfasdfasdfasdfasdfdf asdf "
                android:textColor="@color/text_2B"
                android:textSize="15dp" />

            <vector.image.NImageView
                android:id="@+id/form_niv"
                android:layout_width="100dp"
                android:layout_height="70dp"
                android:layout_marginTop="10dp"
                android:layout_weight="0" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginBottom="14dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/form_tv_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1月3日"
                android:textColor="@color/text_75"
                android:textSize="13dp" />

            <TextView
                android:id="@+id/form_tv_num"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:text="阅读数80"
                android:textColor="@color/text_75"
                android:textSize="13dp" />
        </LinearLayout>
    </RelativeLayout>


</RelativeLayout>