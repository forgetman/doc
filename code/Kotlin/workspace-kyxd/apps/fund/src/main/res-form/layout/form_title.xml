<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="7dp"
        android:background="@drawable/item_selector">

        <TextView
            android:id="@+id/form_tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/gap_horizontal"
            android:text="普通贷款"
            android:textColor="@color/text_2B"
            android:textSize="15dp" />

        <TextView
            android:id="@+id/form_tv_more"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/gap_horizontal"
            android:drawablePadding="5dp"
            android:drawableRight="@drawable/ic_arrow"
            android:text="更多"
            android:textColor="@color/text_75"
            android:textSize="12dp" />
    </RelativeLayout>

    <View style="@style/divider" />

</merge>