<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">

    <data>

        <variable
            name="item"
            type="lib.base.model.Test" />
    </data>

    <TextView
        android:id="@+id/item_text_tv"
