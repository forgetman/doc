<?xml version="1.0" encoding="utf-8"?><!--suppress AndroidUnknownAttribute -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="owner"
            type="pretimmediat.activity.SetupActivity" />

    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/margin_horizontal"
        tools:ignore="MissingConstraints">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/item_height"
            android:layout_marginTop="30dp"
            android:background="@drawable/bg_stoke_corner_gray"
            android:view_onClick="@{owner.onFrenchClick}">

            <TextView
                style="@style/ConstraintLayout.Align.CenterVertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="19dp"
                android:drawablePadding="11dp"
                android:text="@string/french"
                app:drawableStartCompat="@drawable/setup_ic_language"
                app:layout_constraintStart_toStartOf="parent" />

            <androidx.appcompat.widget.AppCompatImageView
                style="@style/ConstraintLayout.Align.CenterVertical"
                android:layout_width="11dp"
                android:layout_height="18dp"
                android:layout_marginEnd="19dp"
                android:src="@drawable/loan_ic_arrow"
                app:layout_constraintEnd_toEndOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/item_height"
            android:layout_marginTop="19dp"
            android:background="@drawable/bg_stoke_corner_gray"
            android:view_onClick="@{owner.onChineseClick}">

            <TextView
                style="@style/ConstraintLayout.Align.CenterVertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="19dp"
                android:drawablePadding="11dp"
                android:text="@string/chinese"
                app:drawableStartCompat="@drawable/setup_ic_language"
                app:layout_constraintStart_toStartOf="parent" />

            <androidx.appcompat.widget.AppCompatImageView
                style="@style/ConstraintLayout.Align.CenterVertical"
                android:layout_width="11dp"
                android:layout_height="18dp"
                android:layout_marginEnd="19dp"
                android:src="@drawable/loan_ic_arrow"
                app:layout_constraintEnd_toEndOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:id="@+id/login_tv_obtain_captcha"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginHorizontal="29dp"
            android:layout_marginTop="129dp"
            android:background="@drawable/bg_stoke_corner_blue"
            android:gravity="center"
            android:text="@string/logout"
            android:textColor="@color/blue"
            android:textSize="17dp"
            android:view_onClick="@{owner.onLogoutClick}"
            tools:ignore="SpUsage" />
    </LinearLayout>
</layout>