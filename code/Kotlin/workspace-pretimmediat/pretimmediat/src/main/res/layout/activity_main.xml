<?xml version="1.0" encoding="utf-8"?><!--suppress AndroidUnknownAttribute -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="MissingConstraints,HardcodedText">

    <data>

        <variable
            name="owner"
            type="pretimmediat.activity.MainActivity" />

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <vector.widget.viewpager.ViewPager
            style="@style/ConstraintLayout.Match.Horizontal"
            android:layout_height="0dp"
            android:viewPager_currentItem="@={owner.currIndex}"
            android:viewPager_fragPager="@{owner.pager}"
            android:viewPager_offscreenPageLimit="@{owner.pager.size}"
            android:viewPager_scrollable="@{false}"
            android:viewPager_smoothScroll="@{false}"
            app:layout_constraintBottom_toTopOf="@id/main_layout_group"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:id="@+id/main_layout_group"
            style="@style/ConstraintLayout.Match.Horizontal"
            android:layout_height="65dp"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/main_iv_home"
                style="@style/View.Image.MainTab"
                android:src="@drawable/main_selector_tab_home"
                android:view_isSelected="@{owner.currIndex == owner.TAB_HOME}" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/main_iv_order"
                style="@style/View.Image.MainTab"
                android:src="@drawable/main_selector_tab_order"
                android:view_isSelected="@{owner.currIndex == owner.TAB_ORDER}" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/main_iv_me"
                style="@style/View.Image.MainTab"
                android:src="@drawable/main_selector_tab_me"
                android:view_isSelected="@{owner.currIndex == owner.TAB_ME}" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>


</layout>
