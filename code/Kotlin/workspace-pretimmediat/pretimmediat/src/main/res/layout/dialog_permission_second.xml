<?xml version="1.0" encoding="utf-8"?><!--suppress AndroidUnknownAttribute -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="owner"
            type="pretimmediat.dialog.PermissionSecondDialog" />
    </data>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="@dimen/radius">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            tools:ignore="MissingConstraints,SpUsage">

            <TextView
                android:id="@+id/tv_title"
                style="@style/ConstraintLayout.Match.Horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="27dp"
                android:text="@string/permission_title"
                android:textColor="@color/text_primary"
                android:textSize="17dp"
                app:layout_constraintTop_toTopOf="parent" />

            <vector.widget.scrollable.ListView
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="10dp"
                android:listView_decoration="@{owner.decoration}"
                android:listView_itemBinder="@{owner.binder}"
                android:listView_itemData="@{owner.data}"
                app:layout_constraintBottom_toTopOf="@id/layout_bottom"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_title" />

            <androidx.constraintlayout.helper.widget.Flow
                android:id="@+id/layout_bottom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                app:constraint_referenced_ids="tv_refuse,tv_accept"
                app:flow_maxElementsWrap="2"
                app:flow_wrapMode="chain"
                app:layout_constraintBottom_toBottomOf="parent" />

            <TextView
                android:id="@+id/tv_refuse"
                android:layout_width="145dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_stoke_corner_blue"
                android:gravity="center"
                android:text="@string/permission_refuse"
                android:textColor="@color/blue"
                android:textSize="17dp"
                android:view_onClick="@{owner.onRefuseClick}" />

            <TextView
                android:id="@+id/tv_accept"
                android:layout_width="145dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_corner_blue"
                android:gravity="center"
                android:text="@string/permission_accept"
                android:textColor="@color/white"
                android:textSize="17dp"
                android:view_onClick="@{owner.onAcceptClick}" />
        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>
</layout>