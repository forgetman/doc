<?xml version="1.0" encoding="utf-8"?><!--suppress AndroidUnknownAttribute -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="owner"
            type="pretimmediat.activity.inputpiece.bank.BankPieceUpdateActivity" />

        <variable
            name="viewModel"
            type="pretimmediat.viewmodel.inputpiece.BankPieceViewModel" />

        <import type="vector.ext.StringKt" />
    </data>


    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_root"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fitsSystemWindows="true"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/margin_horizontal"
            tools:ignore="Autofill,SpUsage,UselessParent,MissingConstraints">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layout_bank_type"
                style="@style/ConstraintLayout.Match.Horizontal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                tools:ignore="MissingConstraints,SpUsage">

                <TextView
                    android:id="@+id/tv_bank_type"
                    style="@style/View.Text.Info.Title"
                    android:text="@string/piece_bank_type" />

                <TextView
                    style="@style/View.Text.Info.Selection"
                    android:text="@{viewModel.bankTypeText}"
                    android:view_onDebounceClick="@{owner.onBankTypeClick}"
                    app:layout_constraintTop_toBottomOf="@id/tv_bank_type" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layout_bank_account"
                style="@style/ConstraintLayout.Match.Horizontal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                app:layout_constraintTop_toBottomOf="@id/layout_bank_type">

                <TextView
                    android:id="@+id/tv_bank_account"
                    style="@style/View.Text.Info.Title"
                    android:text="@string/piece_bank_account" />

                <EditText
                    android:id="@+id/et_bank_account"
                    style="@style/View.Edit.Info.Content"
                    android:hint="@string/enter"
                    android:inputType="number"
                    android:text="@={viewModel.bankAccount}"
                    app:layout_constraintTop_toBottomOf="@id/tv_bank_account" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:src="@drawable/piece_ic_clear"
                    android:view_onClick="@{owner.onBankAccountClearClick}"
                    android:view_visible="@{StringKt.isNotNullOrEmpty(viewModel.bankAccount)}"
                    app:layout_constraintBottom_toBottomOf="@id/et_bank_account"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/et_bank_account" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layout_bank_confirm"
                style="@style/ConstraintLayout.Match.Horizontal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                app:layout_constraintTop_toBottomOf="@id/layout_bank_account"
                tools:ignore="MissingConstraints,SpUsage">

                <TextView
                    android:id="@+id/tv_bank_confirm"
                    style="@style/View.Text.Info.Title"
                    android:text="@string/piece_bank_confirm" />

                <EditText
                    android:id="@+id/et_bank_confirm"
                    style="@style/View.Edit.Info.Content"
                    android:inputType="number"
                    android:text="@={viewModel.bankAccountConfirm}"
                    app:layout_constraintTop_toBottomOf="@id/tv_bank_confirm" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:src="@drawable/piece_ic_clear"
                    android:view_onClick="@{owner.onBankAccountConfirmClearClick}"
                    android:view_visible="@{StringKt.isNotNullOrEmpty(viewModel.bankAccountConfirm)}"
                    app:layout_constraintBottom_toBottomOf="@id/et_bank_confirm"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/et_bank_confirm" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:id="@+id/tv_button"
                style="@style/ConstraintLayout.Match.Horizontal"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginHorizontal="48dp"
                android:layout_marginTop="54dp"
                android:background="@drawable/selector_next"
                android:enabled="@{owner.nextStep.nextEnabled}"
                android:gravity="center"
                android:text="@string/next_step"
                android:textColor="@color/white"
                android:textSize="17dp"
                android:view_isSelected="@{owner.nextStep.selected}"
                android:view_onDebounceClick="@{owner.nextStep.onNextClick}"
                app:layout_constraintTop_toBottomOf="@id/layout_bank_confirm" />

            <TextView
                style="@style/ConstraintLayout.Match.Horizontal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="50dp"
                android:gravity="center_horizontal"
                android:lineSpacingExtra="5dp"
                android:text="@{owner.nextStep.protocol}"
                android:textColor="@color/text_primary"
                android:textSize="12dp"
                android:textView_movementMethod="@{owner.nextStep.movementMethod}"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_button"
                tools:text="请查看我们的隐私协议请查看我们的隐私协议请查看我们的隐私协议请查看我们的隐私协议" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</layout>