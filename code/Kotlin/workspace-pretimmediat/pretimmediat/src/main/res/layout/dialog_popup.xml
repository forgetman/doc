<?xml version="1.0" encoding="utf-8"?><!--suppress AndroidUnknownAttribute -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="owner"
            type="pretimmediat.dialog.PopupDialog" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        tools:background="@color/gray">

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginBottom="10dp"
            android:src="@drawable/ic_close"
            android:view_onClick="@{owner.onCloseClick}" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="@dimen/radius">

            <vector.widget.scrollable.ListView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:listView_decoration="@{owner.decoration}"
                android:listView_itemBinder="@{owner.binder}"
                android:listView_itemData="@{owner.data}"
                android:listView_onItemClick="@{owner.onItemClick}" />
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</layout>