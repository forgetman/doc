<?xml version="1.0" encoding="utf-8"?><!--suppress AndroidUnknownAttribute -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="owner"
            type="pretimmediat.dialog.RepaymentSuccessDialog" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        tools:background="@color/gray"
        tools:ignore="SpUsage,MissingConstraints,HardcodedText">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="@dimen/margin_horizontal"
            android:layout_weight="1"
            app:cardCornerRadius="@dimen/radius">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layout_content"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/white"
                android:paddingHorizontal="12dp">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/iv_sketch"
                    style="@style/ConstraintLayout.Align.CenterHorizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="40dp"
                    android:src="@drawable/dialog_ic_success"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tv_content"
                    style="@style/ConstraintLayout.Match.Horizontal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="@string/repayment_dialog_content"
                    android:textColor="@color/text_primary"
                    android:textSize="14dp"
                    app:layout_constraintTop_toBottomOf="@id/iv_sketch"
                    app:layout_goneMarginTop="32dp" />

                <TextView
                    android:id="@+id/tv_content2"
                    style="@style/ConstraintLayout.Match.Horizontal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@{owner.content2}"
                    android:textColor="@color/text_tertiary"
                    android:textSize="14dp"
                    app:layout_constraintTop_toBottomOf="@id/tv_content"
                    tools:text="Votre montant est élevé à xx. Bienvenue pour emprunter à nouveau !" />

                <TextView
                    android:id="@+id/tv_button"
                    style="@style/ConstraintLayout.Align.CenterHorizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginTop="46dp"
                    android:layout_marginBottom="84dp"
                    android:background="@drawable/bg_corner_blue"
                    android:gravity="center"
                    android:paddingHorizontal="24dp"
                    android:text="@string/repayment_dialog_button"
                    android:textColor="@color/white"
                    android:textSize="14dp"
                    android:view_onClick="@{owner.onClick}"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_content2" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="27dp"
            android:layout_height="27dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="47dp"
            android:layout_weight="0"
            android:src="@drawable/ic_close"
            android:view_onClick="@{owner.onCloseClick}" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="13dp"
            android:layout_weight="0"
            android:text="@{owner.countdownText}"
            android:textColor="@color/red"
            android:textSize="13dp"
            android:view_visible="@{owner.countdownText != null}"
            tools:text="7s" />
    </LinearLayout>
</layout>