<?xml version="1.0" encoding="utf-8"?><!--suppress AndroidUnknownAttribute -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="owner"
            type="pretimmediat.dialog.Style2Dialog" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        tools:background="@color/gray"
        tools:ignore="SpUsage,MissingConstraints">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="@dimen/margin_horizontal"
            android:layout_weight="1"
            app:cardCornerRadius="@dimen/radius">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layout_content"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/white"
                android:orientation="vertical"
                android:paddingHorizontal="12dp">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/iv_sketch"
                    style="@style/ConstraintLayout.Align.CenterHorizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="40dp"
                    android:imageView_source="@{owner.iconId}"
                    android:view_visible="@{owner.iconId != 0}"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:src="@drawable/network_ic_expired" />

                <TextView
                    android:id="@+id/tv_title"
                    style="@style/ConstraintLayout.Match.Horizontal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="@{owner.content}"
                    android:textColor="@color/text_primary"
                    android:textSize="14dp"
                    app:layout_constraintTop_toBottomOf="@id/iv_sketch"
                    app:layout_goneMarginTop="32dp"
                    tools:text="Cliquez sur le bouton Ouvrir pour accéder à la page des paramètres du réseau." />

                <androidx.constraintlayout.helper.widget.Flow
                    style="@style/ConstraintLayout.Match.Horizontal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="17dp"
                    android:layout_marginBottom="34dp"
                    app:constraint_referenced_ids="tv_left_button,tv_right_button"
                    app:flow_maxElementsWrap="2"
                    app:flow_wrapMode="chain"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_title" />

                <TextView
                    android:id="@+id/tv_left_button"
                    android:layout_width="138dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_stoke_corner_blue"
                    android:gravity="center"
                    android:text="@{owner.buttonLeft}"
                    android:textColor="@color/blue"
                    android:textSize="14dp"
                    android:view_onClick="@{owner.onLeftClick}"
                    tools:text="按钮" />

                <TextView
                    android:id="@+id/tv_right_button"
                    android:layout_width="138dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_corner_blue"
                    android:gravity="center"
                    android:text="@{owner.buttonRight}"
                    android:textColor="@color/white"
                    android:textSize="14dp"
                    android:view_onClick="@{owner.onRightClick}"
                    tools:text="按钮" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="27dp"
            android:layout_height="27dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="47dp"
            android:layout_marginBottom="10dp"
            android:layout_weight="0"
            android:src="@drawable/ic_close"
            android:view_onClick="@{owner.onCloseClick}" />
    </LinearLayout>
</layout>