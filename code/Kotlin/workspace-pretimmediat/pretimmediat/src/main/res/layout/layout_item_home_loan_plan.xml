<?xml version="1.0" encoding="utf-8"?><!--suppress AndroidUnknownAttribute -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="item"
            type="pretimmediat.adapter.LoanPlanAdapter.PlanInfo" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/margin_horizontal"
        android:background="@drawable/bg_corner_blue_light"
        android:paddingVertical="13dp"
        tools:ignore="MissingConstraints,SpUsage">

        <TextView
            android:id="@+id/tv_step"
            style="@style/ConstraintLayout.Align.TopLeft"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawablePadding="5dp"
            android:gravity="center_vertical"
            android:text="@{item.stepText()}"
            android:textColor="@color/yellow"
            android:textSize="12dp"
            app:drawableStartCompat="@drawable/loan_ic_semicircle"
            tools:text="1/3" />

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="11dp"
            android:layout_marginTop="6dp"
            android:text="@{item.title}"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_step"
            tools:text="Le 2e échelonnement est en retard depuis 3 jours" />

        <TextView
            android:id="@+id/tv_date_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="11dp"
            android:layout_marginTop="12dp"
            android:text="@{item.dateTitle}"
            android:textColor="@color/text_secondary"
            android:textSize="13dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_title"
            tools:text="还款日期" />

        <TextView
            android:id="@+id/tv_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="11dp"
            android:text="@{item.dateText}"
            android:textSize="15dp"
            app:layout_constraintBottom_toBottomOf="@id/tv_date_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tv_date_title"
            tools:text="17-01-2021" />

        <TextView
            android:id="@+id/tv_late_fee_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="11dp"
            android:layout_marginTop="11dp"
            android:text="@string/late_fee"
            android:textColor="#959595"
            android:textSize="12dp"
            android:view_visible="@{item.lateFee != null}"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_date_title" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="11dp"
            android:text="@{@string/xof_prefix + item.lateFee}"
            android:textColor="#959595"
            android:textSize="12dp"
            android:view_visible="@{item.lateFee != null}"
            app:layout_constraintBottom_toBottomOf="@id/tv_late_fee_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tv_late_fee_title"
            tools:text="XOF 876" />

        <TextView
            android:id="@+id/tv_deduction_fee_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="11dp"
            android:layout_marginTop="11dp"
            android:text="@string/deduction_fee"
            android:textColor="#959595"
            android:textSize="12dp"
            android:view_visible="@{item.deductionFee != null}"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_late_fee_title" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="11dp"
            android:text="@{@string/xof_prefix + item.deductionFee}"
            android:textColor="#959595"
            android:textSize="12dp"
            android:view_visible="@{item.deductionFee != null}"
            app:layout_constraintBottom_toBottomOf="@id/tv_deduction_fee_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tv_deduction_fee_title"
            tools:text="XOF 876" />

        <TextView
            android:id="@+id/tv_amount_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="11dp"
            android:layout_marginTop="12dp"
            android:text="@{item.amountTitle}"
            android:textColor="@color/text_secondary"
            android:textSize="13dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_deduction_fee_title"
            tools:text="还款金额" />

        <TextView
            android:id="@+id/tv_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="11dp"
            android:text="@{item.amountText}"
            android:textColor="@color/text_primary"
            android:textSize="15dp"
            app:layout_constraintBottom_toBottomOf="@id/tv_amount_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tv_amount_title"
            tools:text="XOF 3,650" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>