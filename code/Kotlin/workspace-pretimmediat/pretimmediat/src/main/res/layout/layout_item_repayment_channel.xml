<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginTop="14dp"
    android:background="@drawable/bg_corner_cyan"
    tools:ignore="MissingConstraints,SpUsage">

    <TextView
        android:id="@+id/tv_title"
        style="@style/ConstraintLayout.Match.Vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginVertical="15dp"
        android:layout_marginStart="13dp"
        android:textColor="@color/text_primary"
        android:textSize="13dp"
        app:layout_constraintStart_toStartOf="parent"
        tools:text="Canal de" />

    <TextView
        android:id="@+id/tv_repayment"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="14dp"
        android:background="@drawable/bg_corner_blue"
        android:gravity="center"
        android:paddingHorizontal="10dp"
        android:textColor="@color/white"
        android:textSize="14dp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Rembourser\n XOF 1000" />

</androidx.constraintlayout.widget.ConstraintLayout>