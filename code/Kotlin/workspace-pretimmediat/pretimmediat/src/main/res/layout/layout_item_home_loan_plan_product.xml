<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="owner"
            type="pretimmediat.adapter.LoanPlanAdapter.Binder.ProductInfo" />

        <variable
            name="item"
            type="pretimmediat.adapter.LoanPlanAdapter.ProductInfo" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:ignore="MissingConstraints,SpUsage">

        <TextView
            android:id="@+id/tv_title"
            style="@style/ConstraintLayout.Match.Horizontal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/margin_horizontal"
            android:gravity="center_vertical"
            android:text="@{item.title}"
            android:textStyle="bold"
            app:drawableStartCompat="@drawable/home_ic_repaying"
            tools:text="@string/home_single_loan_plan_repaying_title" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_order_number"
            style="@style/ConstraintLayout.Match.Horizontal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/margin_horizontal"
            android:background="@drawable/bg_corner_blue_light"
            android:paddingHorizontal="9dp"
            android:paddingVertical="10dp"
            app:layout_constraintTop_toBottomOf="@id/tv_title">

            <TextView
                android:id="@+id/tv_order_number_title"
                style="@style/ConstraintLayout.Align.CenterVertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="67dp"
                android:text="@string/order_number"
                android:textColor="@color/text_primary"
                android:textSize="12dp"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                style="@style/ConstraintLayout.Align.CenterVertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@{item.product.orderNo}"
                android:textColor="@color/text_primary"
                android:textSize="12dp"
                app:layout_constraintStart_toEndOf="@id/tv_order_number_title" />

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:onClick="@{() -> owner.listener.onCopyClick()}"
                android:src="@drawable/home_ic_copy"
                app:layout_constraintEnd_toEndOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_container_plan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/margin_horizontal"
            android:layout_marginTop="15dp"
            android:background="@drawable/bg_corner_blue_light"
            android:paddingHorizontal="13dp"
            android:paddingVertical="19dp"
            app:layout_constraintTop_toBottomOf="@id/layout_order_number"
            tools:ignore="MissingConstraints,SpUsage">

            <TextView
                android:id="@+id/tv_date_title"
                style="@style/ConstraintLayout.Align.TopLeft"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/loan_amount"
                android:textColor="@color/text_primary"
                android:textSize="14dp" />

            <TextView
                android:id="@+id/tv_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@{@string/xof_prefix + item.product.applyAmtText}"
                android:textColor="@color/text_primary"
                android:textSize="14dp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@id/tv_date_title"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/tv_date_title"
                tools:text="XOF 3,650" />

            <TextView
                android:id="@+id/tv_amount_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="19dp"
                android:text="@string/apply_date"
                android:textColor="@color/text_primary"
                android:textSize="14dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_date_title" />

            <TextView
                android:id="@+id/tv_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@{item.product.submitTime}"
                android:textColor="@color/text_primary"
                android:textSize="14dp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@id/tv_amount_title"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/tv_amount_title"
                tools:text="17-01-2021" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>