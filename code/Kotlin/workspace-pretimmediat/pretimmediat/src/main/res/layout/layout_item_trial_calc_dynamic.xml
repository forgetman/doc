<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <TextView
        android:id="@+id/tv_amount_dynamic"
        style="@style/View.Text.Loan.Detail"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="动态字段" />

    <TextView
        android:id="@+id/tv_amount_dynamic_value"
        style="@style/View.Text.Loan.Detail.Value"
        app:layout_constraintBottom_toBottomOf="@id/tv_amount_dynamic"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tv_amount_dynamic"
        tools:text="XOF 3650" />
</androidx.constraintlayout.widget.ConstraintLayout>