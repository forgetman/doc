<?xml version="1.0" encoding="utf-8"?><!--suppress AndroidUnknownAttribute -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="owner"
            type="pretimmediat.activity.loan.TrialCalcActivity" />

        <variable
            name="viewModel"
            type="pretimmediat.viewmodel.TrialCalcViewModel" />

        <import type="pretimmediat.ext.ForDataBinding" />
    </data>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:ignore="SpUsage,MissingConstraints">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/margin_horizontal">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:text="@string/loan_amount"
                android:textColor="@color/text_primary"
                android:textSize="17dp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="15dp"
                android:background="@drawable/bg_corner_blue_middle"
                android:gravity="center_vertical"
                android:paddingHorizontal="10dp"
                android:text="@{@string/xof_prefix + (viewModel.loanAmount != null ? ForDataBinding.formatMoney(viewModel.loanAmount) : @string/xof_empty)}"
                android:textColor="@color/text_primary"
                android:textSize="17dp"
                android:view_onDebounceClick="@{owner.onLoanAmountClick}"
                app:drawableEndCompat="@drawable/loan_ic_arrow"
                tools:text="XOF 3650" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:text="@string/trial_calc_number_of_instalment_title"
                android:textColor="@color/text_primary"
                android:textSize="17dp"
                android:textStyle="bold" />

            <androidx.gridlayout.widget.GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="17dp"
                android:gridLayout_columnCount="@{3}"
                android:gridLayout_data="@{owner.gridLayoutSet}" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="35dp"
                android:layout_marginVertical="10dp"
                android:background="@drawable/bg_corner_gray"
                android:gravity="center"
                android:text="@{viewModel.lowestRepay}"
                android:textColor="@color/text_secondary"
                android:textSize="11dp"
                tools:text="@string/trial_calc_number_of_instalment_lowest" />

            <LinearLayout
                android:id="@+id/layout_container_plan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_stoke_corner_gray"
                android:orientation="vertical"
                android:paddingHorizontal="10dp"
                android:paddingVertical="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:gravity="center_vertical"
                    android:text="@string/trial_calc_number_of_instalment_plan"
                    android:textColor="@color/text_primary"
                    android:textSize="17dp"
                    android:textStyle="bold" />
            </LinearLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:background="@drawable/bg_stoke_corner_gray"
                android:orientation="vertical"
                android:paddingHorizontal="10dp"
                android:paddingVertical="20dp"
                tools:ignore="MissingConstraints">

                <TextView
                    android:id="@+id/tv_detail_title"
                    style="@style/ConstraintLayout.Align.TopLeft"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:text="@string/trial_calc_loan_detail"
                    android:textColor="@color/text_primary"
                    android:textSize="17dp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_amount_repay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center_vertical"
                    android:text="@string/trial_calc_loan_amount_repay"
                    android:textColor="#2E2E2E"
                    android:textSize="13dp"
                    app:layout_constraintTop_toBottomOf="@id/tv_detail_title" />

                <TextView
                    style="@style/View.Text.Loan.Detail.Value"
                    android:text="@{@string/xof_prefix + viewModel.perProduct.preAmountText}"
                    android:textColor="@color/blue"
                    app:layout_constraintBottom_toBottomOf="@id/tv_amount_repay"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/tv_amount_repay"
                    tools:text="XOF 3650" />

                <TextView
                    android:id="@+id/tv_amount_receive"
                    style="@style/View.Text.Loan.Detail"
                    android:text="@string/trial_calc_loan_amount_receive"
                    app:layout_constraintTop_toBottomOf="@id/tv_amount_repay" />

                <TextView
                    style="@style/View.Text.Loan.Detail.Value"
                    android:text="@{@string/xof_prefix + viewModel.perProduct.disbursalAmountText}"
                    app:layout_constraintBottom_toBottomOf="@id/tv_amount_receive"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/tv_amount_receive"
                    tools:text="XOF 3650" />

                <TextView
                    android:id="@+id/tv_amount_int"
                    style="@style/View.Text.Loan.Detail"
                    android:text="@string/trial_calc_loan_amount_int"
                    app:layout_constraintTop_toBottomOf="@id/tv_amount_receive" />

                <TextView
                    style="@style/View.Text.Loan.Detail.Value"
                    android:text="@{@string/xof_prefix + viewModel.perProduct.intAmountText}"
                    app:layout_constraintBottom_toBottomOf="@id/tv_amount_int"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/tv_amount_int"
                    tools:text="XOF 3650" />

                <TextView
                    android:id="@+id/tv_amount_service_charge"
                    style="@style/View.Text.Loan.Detail"
                    android:text="@string/trial_calc_loan_service_charge"
                    app:layout_constraintTop_toBottomOf="@id/tv_amount_int" />

                <TextView
                    style="@style/View.Text.Loan.Detail.Value"
                    android:text="@{@string/xof_prefix + viewModel.perProduct.serviceFeeText}"
                    app:layout_constraintBottom_toBottomOf="@id/tv_amount_service_charge"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/tv_amount_service_charge"
                    tools:text="XOF 3650" />

                <TextView
                    android:id="@+id/tv_amount_tax"
                    style="@style/View.Text.Loan.Detail"
                    android:text="@string/trial_calc_loan_tax"
                    app:layout_constraintTop_toBottomOf="@id/tv_amount_service_charge" />

                <TextView
                    style="@style/View.Text.Loan.Detail.Value"
                    android:text="@{@string/xof_prefix + viewModel.perProduct.ivaText}"
                    app:layout_constraintBottom_toBottomOf="@id/tv_amount_tax"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/tv_amount_tax"
                    tools:text="XOF 3650" />

                <LinearLayout
                    android:id="@+id/layout_container_dynamic"
                    style="@style/ConstraintLayout.Match.Horizontal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintTop_toBottomOf="@id/tv_amount_tax" />

                <TextView
                    android:id="@+id/tv_amount"
                    style="@style/View.Text.Loan.Detail"
                    android:text="@string/loan_amount"
                    app:layout_constraintTop_toBottomOf="@id/layout_container_dynamic" />

                <TextView
                    style="@style/View.Text.Loan.Detail.Value"
                    android:text="@{@string/xof_prefix + (viewModel.loanAmount != null ? ForDataBinding.formatMoney(viewModel.loanAmount) : @string/xof_empty)}"
                    android:textColor="@color/blue"
                    app:layout_constraintBottom_toBottomOf="@id/tv_amount"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/tv_amount"
                    tools:text="XOF 3650" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="29dp"
                android:text="@{viewModel.countDownText}"
                android:textColor="@color/text_primary"
                android:textSize="13dp"
                tools:text="@string/trial_calc_loan_passing_rate_part3" />

            <TextView
                android:layout_width="264dp"
                android:layout_height="48dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_corner_blue"
                android:gravity="center"
                android:text="@string/trial_calc_loan_apply"
                android:textColor="@color/white"
                android:textSize="17dp"
                android:view_onDebounceClick="@{owner.onApplyClick}" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="30dp"
                android:background="@drawable/bg_corner_blue_middle"
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="10dp"
                android:view_visible="@{viewModel.contactUrl != null}">

                <ToggleButton
                    android:layout_width="21dp"
                    android:layout_height="21dp"
                    android:background="@drawable/loan_selector_toggle"
                    android:button="@null"
                    android:checked="@={viewModel.protocolToggleChecked}"
                    android:textOff=""
                    android:textOn="" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="@{viewModel.protocol}"
                    android:textColor="@color/text_primary"
                    android:textSize="13dp"
                    android:textView_movementMethod="@{viewModel.movementMethod}"
                    tools:text="我仔细阅读了贷款协议" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</layout>