<?xml version="1.0" encoding="utf-8"?><!--suppress AndroidUnknownAttribute -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="owner"
            type="pretimmediat.adapter.OrderAdapter.Binder.BaseDescription" />

        <variable
            name="item"
            type="pretimmediat.adapter.OrderAdapter.OrderDescription" />
    </data>


    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/margin_horizontal"
        tools:ignore="MissingConstraints,SpUsage,HardcodedText">

        <View
            android:layout_width="0dp"
            android:layout_height="9dp"
            android:backgroundColor="@{owner.titleColor}"
            app:layout_constraintBottom_toBottomOf="@id/tv_title"
            app:layout_constraintEnd_toEndOf="@id/tv_title"
            app:layout_constraintStart_toStartOf="@id/tv_title"
            tools:background="@color/green" />

        <TextView
            android:id="@+id/tv_title"
            style="@style/ConstraintLayout.Align.TopLeft"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@{owner.titleId}"
            android:textColor="@color/text_primary"
            android:textSize="14dp"
            tools:text="Ordre terminer" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_content"
            style="@style/ConstraintLayout.Match.Horizontal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_stoke_corner_gray"
            app:layout_constraintTop_toBottomOf="@id/tv_title">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_logo"
                style="@style/ConstraintLayout.Align.TopLeft"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="7dp"
                android:layout_marginTop="5dp"
                android:imageView_source="@{item.order.logoUrl}"
                android:imageView_transformation="@{owner.transformation}"
                tools:background="@color/gray" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:text="@{item.order.appName}"
                android:textColor="@color/text_primary"
                android:textSize="14dp"
                app:layout_constraintBottom_toBottomOf="@id/iv_logo"
                app:layout_constraintStart_toEndOf="@id/iv_logo"
                app:layout_constraintTop_toTopOf="@id/iv_logo"
                tools:text="APPNAME" />

            <TextView
                android:id="@+id/tv_description"
                style="@style/ConstraintLayout.Match.Horizontal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_marginTop="13dp"
                android:background="@drawable/bg_corner_blue_light"
                android:padding="14dp"
                android:text="@{owner.contentId}"
                android:textColor="@color/text_primary"
                android:textSize="14dp"
                app:layout_constraintTop_toBottomOf="@id/iv_logo"
                tools:text="Cet ordre a été complété, vous pouvez cliquer sur le bouton pour en emprunter un autre" />

            <TextView
                style="@style/ConstraintLayout.Match.Horizontal"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="15dp"
                android:background="@drawable/bg_corner_blue"
                android:gravity="center"
                android:onClick="@{() -> owner.listener.onClick(item.order)}"
                android:text="@{owner.buttonId}"
                android:textColor="@color/white"
                android:textSize="14dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_description"
                tools:text="Demander maintenant" />
        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>