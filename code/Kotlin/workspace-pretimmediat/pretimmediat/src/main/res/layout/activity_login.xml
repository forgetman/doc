<?xml version="1.0" encoding="utf-8"?><!--suppress AndroidUnknownAttribute -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="owner"
            type="pretimmediat.activity.user.LoginActivity" />

        <variable
            name="viewModel"
            type="pretimmediat.viewmodel.LoginViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="@dimen/margin_horizontal"
        tools:ignore="MissingConstraints,SpUsage">

        <TextView
            android:id="@+id/login_tv_title"
            style="@style/ConstraintLayout.Match.Horizontal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="17dp"
            android:lineSpacingExtra="7dp"
            android:text="@string/login_head"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/login_layout_phone"
            android:layout_width="0dp"
            android:layout_height="@dimen/item_height"
            android:layout_marginTop="29dp"
            android:background="@drawable/bg_stoke_corner_gray"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/login_tv_title">

            <TextView
                android:id="@+id/login_tv_country_code"
                style="@style/ConstraintLayout.Align.CenterVertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:drawablePadding="4dp"
                android:text="+229"
                android:textSize="17dp"
                app:drawableStartCompat="@drawable/ic_country_bn"
                app:layout_constraintStart_toStartOf="parent"
                tools:ignore="HardcodedText" />

            <View
                android:id="@+id/login_divider"
                style="@style/ConstraintLayout.Align.CenterVertical"
                android:layout_width="1dp"
                android:layout_height="26dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/login_bg_divider"
                app:layout_constraintStart_toEndOf="@id/login_tv_country_code" />

            <EditText
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:background="@null"
                android:hint="@string/login_hint_phone"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="20"
                android:maxLines="1"
                android:text="@={viewModel.phoneNumber}"
                android:textColor="@color/black"
                android:textColorHint="#999999"
                android:textSize="13dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/login_divider"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <EditText
            android:id="@+id/login_et_captcha"
            style="@style/ConstraintLayout.Match.Horizontal"
            android:layout_width="0dp"
            android:layout_height="@dimen/item_height"
            android:layout_marginTop="19dp"
            android:background="@drawable/bg_stoke_corner_gray"
            android:gravity="center_vertical"
            android:hint="@string/login_hint_captcha"
            android:importantForAutofill="no"
            android:inputType="number"
            android:maxLength="4"
            android:maxLines="1"
            android:paddingHorizontal="10dp"
            android:text="@={viewModel.captcha}"
            android:textColor="@color/black"
            android:textColorHint="#999"
            android:textSize="13dp"
            app:layout_constraintTop_toBottomOf="@+id/login_layout_phone" />

        <TextView
            android:id="@+id/login_tv_obtain_captcha"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginTop="19dp"
            android:background="@drawable/login_bg_fetch_captcha"
            android:enabled="@{viewModel.fetchEnable}"
            android:gravity="center"
            android:paddingHorizontal="18dp"
            android:text="@{viewModel.countDownText}"
            android:textColor="@color/login_text_fetch_captcha"
            android:textSize="12dp"
            android:view_onClick="@{owner.onCaptchaClick}"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/login_et_captcha"
            tools:text="@string/login_obtain_captcha" />

        <TextView
            style="@style/ConstraintLayout.Match.Horizontal"
            android:layout_width="264dp"
            android:layout_height="48dp"
            android:layout_marginTop="19dp"
            android:background="@drawable/selector_next"
            android:gravity="center"
            android:text="@string/login_next_step"
            android:textColor="@color/white"
            android:textSize="14dp"
            android:view_isSelected="@{viewModel.nextSelected}"
            android:view_onClick="@{owner.onNextClick}"
            app:layout_constraintTop_toBottomOf="@id/login_tv_obtain_captcha" />

        <androidx.cardview.widget.CardView
            style="@style/ConstraintLayout.Match.Horizontal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:view_visible="@{viewModel.smsVisible}"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="@dimen/radius"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_corner_white"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="14dp"
                    android:drawablePadding="10dp"
                    android:gravity="center_vertical"
                    android:text="@{viewModel.smsContent}"
                    android:textColor="@color/black"
                    android:textSize="13dp"
                    app:drawableStartCompat="@drawable/login_ic_sms"
                    tools:text="[Prêt immédiat] Votre code SMS de vérification: 1234" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#DEDEDE" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingVertical="12dp"
                    android:text="@{viewModel.smsCountdownText}"
                    android:textColor="@color/blue"
                    android:textSize="13dp"
                    android:view_onClick="@{owner.onSmsReadClick}"
                    tools:text="Marquer comme lu (5S)" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>