<?xml version="1.0" encoding="utf-8"?><!--suppress AndroidUnknownAttribute -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="item"
            type="pretimmediat.activity.inputpiece.AbstractPieceActivity.NextStep" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="48dp"
        tools:ignore="MissingConstraints,SpUsage">

        <TextView
            android:id="@+id/tv_tips"
            style="@style/ConstraintLayout.Match.Horizontal"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/piece_next_bg_arrow"
            android:gravity="center"
            android:text="@{item.moneyText}"
            android:textColor="@color/text_primary"
            android:textSize="12dp"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Offres de 260,000 $ après achèvement" />

        <TextView
            android:id="@+id/tv_title"
            style="@style/ConstraintLayout.Match.Horizontal"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginTop="5dp"
            android:background="@drawable/selector_next"
            android:enabled="@{item.nextEnabled}"
            android:gravity="center"
            android:text="@string/next_step"
            android:textColor="@color/white"
            android:textSize="17dp"
            android:view_isSelected="@{item.selected}"
            android:view_onDebounceClick="@{item.onNextClick}"
            app:layout_constraintTop_toBottomOf="@id/tv_tips" />

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="33dp"
            android:src="@drawable/piece_ic_arrow_bottom"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_tips" />

        <TextView
            style="@style/ConstraintLayout.Match.Horizontal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="30dp"
            android:gravity="center"
            android:lineSpacingExtra="5dp"
            android:text="@{item.protocol}"
            android:textColor="@color/text_primary"
            android:textSize="12dp"
            android:textView_movementMethod="@{item.movementMethod}"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_title"
            tools:text="请查看我们的隐私协议请查看我们的隐私协议请查看我们的隐私协议请查看我们的隐私协议" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>