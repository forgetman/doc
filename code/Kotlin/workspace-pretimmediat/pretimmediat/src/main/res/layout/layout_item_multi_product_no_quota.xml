<?xml version="1.0" encoding="utf-8"?><!--suppress AndroidUnknownAttribute -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="owner"
            type="pretimmediat.adapter.MultiProductAdapter.Binder.NoQuota" />

        <variable
            name="item"
            type="pretimmediat.adapter.MultiProductAdapter.Data" />
    </data>


    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/margin_horizontal"
        tools:ignore="MissingConstraints,SpUsage,HardcodedText">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_content"
            style="@style/ConstraintLayout.Match.Horizontal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_stoke_corner_gray"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_logo"
                style="@style/ConstraintLayout.Align.TopLeft"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginVertical="5dp"
                android:layout_marginStart="7dp"
                android:imageView_source="@{item.product.logoUrl}"
                android:imageView_transformation="@{owner.transformation}"
                app:layout_constraintBottom_toBottomOf="parent"
                tools:background="@color/gray" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:text="@{item.product.appName}"
                android:textColor="@color/text_primary"
                android:textSize="14dp"
                app:layout_constraintBottom_toBottomOf="@id/iv_logo"
                app:layout_constraintStart_toEndOf="@id/iv_logo"
                app:layout_constraintTop_toTopOf="@id/iv_logo"
                tools:text="APPNAME" />

            <TextView
                android:layout_width="128dp"
                android:layout_height="0dp"
                android:background="@drawable/bg_corner_gray_deep"
                android:gravity="center"
                android:onClick="@{() -> owner.listener.onClick(item.product)}"
                android:paddingHorizontal="8dp"
                android:text="@string/home_multi_no_quota_button"
                android:textColor="@color/white"
                android:textSize="14dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>