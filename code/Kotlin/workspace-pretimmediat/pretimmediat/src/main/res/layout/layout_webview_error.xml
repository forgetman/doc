<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:ignore="MissingConstraints,SpUsage">

    <androidx.appcompat.widget.AppCompatImageView
        style="@style/ConstraintLayout.Align.CenterHorizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="113dp"
        android:src="@drawable/webview_ic_error"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_button"
        style="@style/ConstraintLayout.Match.Horizontal"
        android:layout_width="0dp"
        android:layout_height="45dp"
        android:layout_marginHorizontal="@dimen/margin_horizontal"
        android:layout_marginBottom="65dp"
        android:background="@drawable/bg_corner_blue"
        android:gravity="center"
        android:text="@string/network_expired_button"
        android:textColor="@color/white"
        android:textSize="19dp"
        app:layout_constraintBottom_toBottomOf="parent" />

    <TextView
        style="@style/ConstraintLayout.Align.CenterHorizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="42dp"
        android:text="@string/network_expired_title"
        android:textColor="#7A8CA9"
        android:textSize="12dp"
        app:layout_constraintBottom_toTopOf="@id/tv_button" />

</androidx.constraintlayout.widget.ConstraintLayout>