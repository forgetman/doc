<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:ignore="MissingConstraints,SpUsage">

    <View
        android:id="@+id/layout_top"
        style="@style/ConstraintLayout.Match.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="233dp"
        android:background="#DAE1FC" />

    <View
        android:layout_width="84dp"
        android:layout_height="84dp"
        android:layout_marginTop="99dp"
        android:background="@drawable/splash_ic_launcher"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#E7ECFF"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_top" />

    <View
        style="@style/ConstraintLayout.Match.Horizontal"
        android:layout_height="233dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="55dp"
        android:background="@drawable/splash_bg_under_blue"
        app:layout_constraintTop_toBottomOf="@id/layout_top" />

    <View
        android:id="@+id/layout_white"
        style="@style/ConstraintLayout.Match.Horizontal"
        android:layout_width="0dp"
        android:layout_height="227dp"
        android:layout_marginHorizontal="30dp"
        android:layout_marginTop="31dp"
        android:background="@drawable/bg_corner_white"
        app:layout_constraintTop_toBottomOf="@id/layout_top" />

    <TextView
        android:id="@+id/tv_tip1"
        style="@style/ConstraintLayout.Match.Horizontal"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="45dp"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:lineSpacingExtra="6dp"
        android:text="@string/splash_tip_1"
        android:textColor="@color/text_primary"
        android:textSize="12dp"
        app:layout_constraintTop_toTopOf="@id/layout_white" />

    <TextView
        android:id="@+id/tv_tip2"
        style="@style/ConstraintLayout.Match.Horizontal"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="45dp"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:lineSpacingExtra="6dp"
        android:text="@string/splash_tip_2"
        android:textColor="@color/text_primary"
        android:textSize="14dp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/tv_tip1" />

    <TextView
        style="@style/ConstraintLayout.Match.Horizontal"
        android:layout_width="0dp"
        android:layout_height="88dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="215dp"
        android:background="@drawable/splash_bg_irregularity"
        android:gravity="center_horizontal|bottom"
        android:paddingBottom="15dp"
        android:text="@string/splash_tip_3"
        android:textColor="@color/white"
        android:textSize="25dp"
        app:layout_constraintTop_toBottomOf="@id/layout_top" />

</androidx.constraintlayout.widget.ConstraintLayout>