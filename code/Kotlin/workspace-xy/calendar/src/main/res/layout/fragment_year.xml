<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <lib.ys.network.image.NetworkImageView
        android:id="@+id/year_iv_fg"
        android:layout_width="345dp"
        android:layout_height="575dp"
        android:layout_centerInParent="true" />

    <AbsoluteLayout
        android:id="@+id/year_layout_abs"
        android:layout_width="345dp"
        android:layout_height="575dp"
        android:layout_centerInParent="true">

        <lib.ys.network.image.NetworkImageView
            android:id="@+id/year_iv_animal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <lib.ys.network.image.NetworkImageView
            android:id="@+id/year_iv_logo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <LinearLayout
            android:id="@+id/year_layout_years"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <lib.ys.network.image.NetworkImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <lib.ys.network.image.NetworkImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <lib.ys.network.image.NetworkImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <lib.ys.network.image.NetworkImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

    </AbsoluteLayout>

    <AbsoluteLayout
        android:id="@+id/year_layout_months"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true">

        <lib.ys.network.image.NetworkImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <lib.ys.network.image.NetworkImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <lib.ys.network.image.NetworkImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <lib.ys.network.image.NetworkImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <lib.ys.network.image.NetworkImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <lib.ys.network.image.NetworkImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <lib.ys.network.image.NetworkImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <lib.ys.network.image.NetworkImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <lib.ys.network.image.NetworkImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <lib.ys.network.image.NetworkImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <lib.ys.network.image.NetworkImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <lib.ys.network.image.NetworkImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </AbsoluteLayout>
</RelativeLayout>