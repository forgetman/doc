<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/recommand_confirm_dialog_bg"
    android:paddingStart="@dimen/dialog_download_padding"
    android:paddingEnd="@dimen/dialog_download_padding">

    <RelativeLayout
        android:id="@+id/download_confirm_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_marginTop="@dimen/dialog_download_padding">

        <ImageView
            android:id="@+id/download_confirm_iv_logo"
            android:layout_width="@dimen/dialog_download_logo_size"
            android:layout_height="@dimen/dialog_download_logo_size"
            android:layout_alignParentEnd="true"
            android:src="@mipmap/logo" />

        <TextView
            android:id="@+id/download_confirm_tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignBottom="@id/download_confirm_iv_logo"
            android:text="红楼梦(皮肤)"
            android:textColor="@color/white"
            android:textSize="@dimen/dialog_download_title_text_size" />
    </RelativeLayout>

    <TextView
        android:id="@+id/download_confirm_tv_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/download_confirm_layout"
        android:layout_marginStart="@dimen/dialog_download_content_margin"
        android:layout_marginEnd="@dimen/dialog_download_content_margin"
        android:layout_marginTop="@dimen/dialog_download_content_margin"
        android:text="金陵十二钗副业"
        android:textColor="@color/white"
        android:textSize="@dimen/dialog_download_content_text_size" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/download_confirm_tv_content"
        android:layout_marginTop="15dp"
        android:orientation="horizontal"
        android:paddingBottom="20dp">

        <TextView
            android:id="@+id/download_confirm_tv_download"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/dialog_btn_download"
            android:textSize="@dimen/dialog_download_btn_text_size" />

        <TextView
            android:id="@+id/download_confirm_tv_cancel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/dialog_btn_cancel"
            android:textSize="@dimen/dialog_download_btn_text_size" />
    </LinearLayout>

</RelativeLayout>