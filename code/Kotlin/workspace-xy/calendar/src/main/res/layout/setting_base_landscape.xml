<?xml version="1.0" encoding="utf-8"?>
<AbsoluteLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:ignore="Deprecated,ContentDescription">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center">

        <AbsoluteLayout
            android:id="@+id/setting_rl_bg_up"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true">

            <ImageView
                android:id="@+id/setting_iv_bg_up"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <ImageView
                android:id="@+id/setting_iv_tab_skin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <ImageView
                android:id="@+id/setting_iv_tab_setting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <ImageView
                android:id="@+id/setting_iv_tab_recommand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <ImageView
                android:id="@+id/setting_iv_split_line_up"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </AbsoluteLayout>

        <AbsoluteLayout
            android:id="@+id/setting_rl_bg_mid"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_toRightOf="@id/setting_rl_bg_up">

            <ImageView
                android:id="@+id/setting_iv_bg_mid"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:scaleType="fitXY" />
        </AbsoluteLayout>

        <AbsoluteLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_toRightOf="@id/setting_rl_bg_mid">

            <ImageView
                android:id="@+id/setting_iv_bg_down"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <ImageView
                android:id="@+id/setting_tab_skin_iv_split_line"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                tools:ignore="ContentDescription" />

            <TextView
                android:id="@+id/setting_tv_entry_about"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/setting_entry_about"
                android:textColor="@color/white"
                android:visibility="visible" />

            <ImageView
                android:id="@+id/setting_iv_home"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </AbsoluteLayout>
    </RelativeLayout>

    <include
        android:id="@+id/setting_tab_set"
        layout="@layout/setting_tab_set" />

    <include
        android:id="@+id/setting_tab_skin"
        layout="@layout/setting_tab_skin_landscape" />

    <include
        android:id="@+id/setting_tab_recommand"
        layout="@layout/setting_tab_recommand_landscape" />

</AbsoluteLayout>