<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <AbsoluteLayout
        android:id="@+id/month_item_day_layout_root"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <lib.ys.network.image.NetworkImageView
            android:id="@+id/month_item_iv_highlight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <LinearLayout
            android:id="@+id/month_item_day_layout_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <lib.ys.network.image.NetworkImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <lib.ys.network.image.NetworkImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <lib.ys.view.AutoScaleTextView
            android:id="@+id/month_item_day_tv_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </AbsoluteLayout>

</LinearLayout>