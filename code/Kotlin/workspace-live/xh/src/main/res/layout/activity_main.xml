<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="HardcodedText,SpUsage,Autofill,LabelFor">

    <data>

        <variable
            name="owner"
            type="star.design.ui.activity.MainActivity" />

        <variable
            name="viewModel"
            type="star.design.viewModel.MainViewModel" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:orientation="vertical">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="20dp"
                    android:background="@color/gray"
                    android:gravity="center"
                    android:text="计算条件"
                    android:textSize="13dp" />

                <LinearLayout style="@style/View.Condition.Layout">

                    <TextView
                        style="@style/View.Text.Condition"
                        android:text="公会分成比例" />

                    <EditText
                        style="@style/View.Edit.Condition"
                        android:layout_marginEnd="0dp"
                        android:inputType="number"
                        android:textView_intNumber="@{viewModel.input.unionDividend}"
                        android:textView_textChanged="@{owner.onUnionDividendChanged}" />

                    <TextView
                        style="@style/View.Text.Condition"
                        android:layout_marginStart="0dp"
                        android:layout_marginEnd="@dimen/margin"
                        android:text="%" />
                </LinearLayout>

                <View style="@style/View.Condition.Divider" />

                <LinearLayout style="@style/View.Condition.Layout">

                    <TextView
                        style="@style/View.Text.Condition"
                        android:text="主播分成比例" />

                    <EditText
                        style="@style/View.Edit.Condition"
                        android:layout_marginEnd="0dp"
                        android:inputType="number"
                        android:textView_intNumber="@{viewModel.input.employeeDividend}"
                        android:textView_textChanged="@{owner.onAnchorDividendChanged}" />

                    <TextView
                        style="@style/View.Text.Condition"
                        android:layout_marginStart="0dp"
                        android:layout_marginEnd="@dimen/margin"
                        android:text="%" />
                </LinearLayout>

                <View style="@style/View.Condition.Divider" />

                <LinearLayout style="@style/View.Condition.Layout">

                    <TextView
                        style="@style/View.Text.Condition"
                        android:text="日开播时长" />

                    <EditText
                        style="@style/View.Edit.Condition"
                        android:layout_marginEnd="0dp"
                        android:inputType="number"
                        android:textView_intNumber="@={viewModel.input.dayDuration}" />

                    <TextView
                        style="@style/View.Text.Condition"
                        android:layout_marginStart="0dp"
                        android:layout_marginEnd="@dimen/margin"
                        android:text="小时" />
                </LinearLayout>

                <View style="@style/View.Condition.Divider" />

                <LinearLayout style="@style/View.Condition.Layout">

                    <TextView
                        style="@style/View.Text.Condition"
                        android:text="月开播天数" />

                    <EditText
                        style="@style/View.Edit.Condition"
                        android:layout_marginEnd="0dp"
                        android:inputType="number"
                        android:textView_intNumber="@{viewModel.input.monthDuration}" />

                    <TextView
                        style="@style/View.Text.Condition"
                        android:layout_marginStart="0dp"
                        android:layout_marginEnd="@dimen/margin"
                        android:text="天" />
                </LinearLayout>

                <View style="@style/View.Condition.Divider" />

                <LinearLayout style="@style/View.Condition.Layout">

                    <TextView
                        style="@style/View.Text.Condition"
                        android:text="日流水" />

                    <EditText
                        style="@style/View.Edit.Condition"
                        android:inputType="number"
                        android:textView_intNumber="@{viewModel.input.dayFlow}"
                        android:textView_textChanged="@{owner.onDayFlowChanged}" />
                </LinearLayout>

                <View style="@style/View.Condition.Divider" />

                <LinearLayout style="@style/View.Condition.Layout">

                    <TextView
                        style="@style/View.Text.Condition"
                        android:text="月流水" />

                    <EditText
                        style="@style/View.Edit.Condition"
                        android:inputType="number"
                        android:textView_intNumber="@{viewModel.input.monthFlow}"
                        android:textView_textChanged="@{owner.onMonthFlowChanged}" />
                </LinearLayout>

                <View style="@style/View.Condition.Divider" />

                <LinearLayout style="@style/View.Condition.Layout">

                    <TextView
                        style="@style/View.Text.Condition"
                        android:text="主持数量" />

                    <EditText
                        style="@style/View.Edit.Condition"
                        android:inputType="number"
                        android:textView_intNumber="@={viewModel.input.hostSize}" />
                </LinearLayout>

                <View style="@style/View.Condition.Divider" />

                <LinearLayout style="@style/View.Condition.Layout">

                    <TextView
                        style="@style/View.Text.Condition"
                        android:text="主持每小时补贴" />

                    <EditText
                        style="@style/View.Edit.Condition"
                        android:inputType="number"
                        android:textView_intNumber="@={viewModel.input.hostSubsidyAnHour}" />
                </LinearLayout>

                <View style="@style/View.Condition.Divider" />

                <LinearLayout style="@style/View.Condition.Layout">

                    <TextView
                        style="@style/View.Text.Condition"
                        android:text="主播数量" />

                    <EditText
                        style="@style/View.Edit.Condition"
                        android:inputType="number"
                        android:textView_intNumber="@={viewModel.input.anchorSize}" />
                </LinearLayout>

                <View style="@style/View.Condition.Divider" />

                <LinearLayout style="@style/View.Condition.Layout">

                    <TextView
                        style="@style/View.Text.Condition"
                        android:text="主播每小时补贴" />

                    <EditText
                        style="@style/View.Edit.Condition"
                        android:inputType="number"
                        android:textView_intNumber="@={viewModel.input.anchorSubsidyAnHour}" />
                </LinearLayout>

                <View style="@style/View.Condition.Divider" />

                <LinearLayout
                    style="@style/View.Condition.Layout"
                    android:view_onClick="@{owner.hallClick}">

                    <TextView
                        style="@style/View.Text.Condition"
                        android:text="语音厅数量" />

                    <TextView style="@style/View.Edit.Condition" />
                </LinearLayout>

                <View style="@style/View.Condition.Divider" />

                <LinearLayout
                    style="@style/View.Condition.Layout"
                    android:view_onClick="@{owner.onRebateClick}">

                    <TextView
                        style="@style/View.Text.Condition"
                        android:text="返点" />

                </LinearLayout>

                <View style="@style/View.Condition.Divider" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="20dp"
                    android:background="@color/gray"
                    android:gravity="center"
                    android:text="计算结果"
                    android:textSize="13dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="公会" />

                        <LinearLayout style="@style/View.Result.Layout">

                            <TextView
                                style="@style/View.Text.Result"
                                android:text="日利润" />

                            <TextView
                                style="@style/View.Text.Result.Value"
                                android:layout_marginStart="@dimen/margin"
                                android:text="@{viewModel.unionDayEarnings}" />
                        </LinearLayout>

                        <View style="@style/View.Result.Divider" />

                        <LinearLayout style="@style/View.Result.Layout">

                            <TextView
                                style="@style/View.Text.Result"
                                android:text="月利润" />

                            <TextView
                                style="@style/View.Text.Result.Value"
                                android:layout_marginStart="@dimen/margin"
                                android:text="@{viewModel.unionMonthEarnings}" />
                        </LinearLayout>

                        <View style="@style/View.Result.Divider" />

                        <LinearLayout style="@style/View.Result.Layout">

                            <TextView
                                style="@style/View.Text.Result"
                                android:text="新入驻返点" />

                            <TextView
                                style="@style/View.Text.Result.Value"
                                android:layout_marginStart="@dimen/margin"
                                android:text="@{viewModel.newSettleInRebate}" />
                        </LinearLayout>

                        <View style="@style/View.Result.Divider" />

                        <LinearLayout style="@style/View.Result.Layout">

                            <TextView
                                style="@style/View.Text.Result"
                                android:text="返点" />

                            <TextView
                                style="@style/View.Text.Result.Value"
                                android:layout_marginStart="@dimen/margin"
                                android:text="@{viewModel.rebate}" />
                        </LinearLayout>

                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/gray" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="员工" />

                        <LinearLayout style="@style/View.Result.Layout">

                            <TextView
                                style="@style/View.Text.Result"
                                android:text="主播日收入(单)" />

                            <TextView
                                style="@style/View.Text.Result.Value"
                                android:layout_marginStart="@dimen/margin"
                                android:text="@{viewModel.singleAnchorDayEarnings}" />
                        </LinearLayout>

                        <View style="@style/View.Result.Divider" />

                        <LinearLayout style="@style/View.Result.Layout">

                            <TextView
                                style="@style/View.Text.Result"
                                android:text="主播月收入(单)" />

                            <TextView
                                style="@style/View.Text.Result.Value"
                                android:layout_marginStart="@dimen/margin"
                                android:text="@{viewModel.singleAnchorMonthEarnings}" />
                        </LinearLayout>

                        <View style="@style/View.Result.Divider" />

                        <LinearLayout style="@style/View.Result.Layout">

                            <TextView
                                style="@style/View.Text.Result"
                                android:text="主播日收入(全)" />

                            <TextView
                                style="@style/View.Text.Result.Value"
                                android:layout_marginStart="@dimen/margin"
                                android:text="@{viewModel.allAnchorDayEarnings}" />
                        </LinearLayout>

                        <View style="@style/View.Result.Divider" />

                        <LinearLayout style="@style/View.Result.Layout">

                            <TextView
                                style="@style/View.Text.Result"
                                android:text="主播月收入(全)" />

                            <TextView
                                style="@style/View.Text.Result.Value"
                                android:layout_marginStart="@dimen/margin"
                                android:text="@{viewModel.allAnchorMonthEarnings}" />
                        </LinearLayout>

                        <View style="@style/View.Result.Divider" />

                        <LinearLayout style="@style/View.Result.Layout">

                            <TextView
                                style="@style/View.Text.Result"
                                android:text="主持日收入(单)" />

                            <TextView
                                style="@style/View.Text.Result.Value"
                                android:layout_marginStart="@dimen/margin"
                                android:text="@{viewModel.singleHostDayEarnings}" />
                        </LinearLayout>

                        <View style="@style/View.Result.Divider" />

                        <LinearLayout style="@style/View.Result.Layout">

                            <TextView
                                style="@style/View.Text.Result"
                                android:text="主持月收入(单)" />

                            <TextView
                                style="@style/View.Text.Result.Value"
                                android:layout_marginStart="@dimen/margin"
                                android:text="@{viewModel.singleHostMonthEarnings}" />
                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="0"
            android:text="计算"
            android:view_onClick="@{owner.onCalcClick}" />
    </LinearLayout>
</layout>