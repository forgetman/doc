<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">

    <data>

        <variable
            name="owner"
            type="star.design.ui.activity.edit.CommonEditActivity" />
    </data>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout style="@style/View.Condition.Layout">

            <TextView
                style="@style/View.Text.Condition"
                android:text="@{owner.text}" />

            <EditText
                style="@style/View.Edit.Condition"
                android:hint="@{owner.hint}"
                android:inputType="@{owner.inputType}"
                android:textView_textChanged="@{owner.textChanged}" />
        </LinearLayout>

    </FrameLayout>
</layout>